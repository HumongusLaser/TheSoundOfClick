@page "/profile"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Data.Common
@attribute [Authorize]
@inject NavigationManager Navigation
@inject UserService UserService
@inject OrderService OrderService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Profile> Logger

<PageTitle>Min profil | The Sound Of Click</PageTitle>

<div class="page-content">

    <h1>Min profil</h1>

    <p class="page-description">
        Her kan du se og administrere dine personlige oplysninger.
    </p>

    <hr />

    @if (IsLoading)
    {
        <p>Indlæser dine oplysninger...</p>
    }
    else if (!string.IsNullOrEmpty(LoadError))
    {
        <p class="text-danger" role="alert">@LoadError</p>
    }
    else
    {
    @if (!string.IsNullOrEmpty(AccountDeleteError))
    {
        <p class="text-danger" role="alert">@AccountDeleteError</p>
    }

    <div class="employee-form-section mt-4">

        <h3>Personlige oplysninger</h3>

        <div class="row g-3 mt-2">

            <div class="col-md-6">
                <label class="form-label">Fornavn</label>
                <input class="form-control"
                       value="@FirstName"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">Efternavn</label>
                <input class="form-control"
                       value="@LastName"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">E-mail</label>
                <input class="form-control"
                       value="@Email"
                       readonly />
            </div>

            <div class="col-md-6">
                <label class="form-label">Telefonnummer</label>
                <input class="form-control"
                       value="@PhoneNumber"
                       readonly />
            </div>

        </div>

        <button type="button"
                class="page-button mt-4"
                @onclick="OpenPersonalPopup">
            Rediger oplysninger
        </button>

    </div>


    <div class="employee-form-section mt-4">

        <h3>Min adresse</h3>

        <div class="row g-3 mt-2">

            <div class="col-md-8">
                <label class="form-label">Adresse</label>
                <input class="form-control"
                       value="@StreetAddress"
                       readonly />
            </div>

            <div class="col-md-4">
                <label class="form-label">Lejlighed</label>
                <input class="form-control"
                       value="@Apartment"
                       readonly />
            </div>

            <div class="col-md-4">
                <label class="form-label">Postnummer</label>
                <input class="form-control"
                       value="@PostalCode"
                       readonly />
            </div>

            <div class="col-md-8">
                <label class="form-label">By</label>
                <input class="form-control"
                       value="@City"
                       readonly />
            </div>

        </div>

        <button type="button"
                class="page-button mt-4"
                @onclick="OpenAddressPopup">
            Rediger adresse
        </button>

    </div>

    <div class="employee-form-section mt-4">

        <h3>Sikkerhed</h3>

        <p class="page-description">
            Her kan du ændre din adgangskode.
        </p>

        <button type="button"
                class="page-button-outline mt-2"
                @onclick="GoToChangePassword">
            Skift adgangskode
        </button>

    </div>


    <section class="employee-form-section profile-orders-section mt-4">
        <div class="profile-orders-heading">
            <div>
                <h3>Mine ordrer</h3>
                <p>Se dine tidligere køb og ordreoplysninger.</p>
            </div>
            <span class="profile-order-count">@OrderHistory.Count ordre@(OrderHistory.Count == 1 ? "" : "r")</span>
        </div>

        @if (!string.IsNullOrEmpty(OrderHistoryError))
        {
            <p class="text-danger" role="alert">@OrderHistoryError</p>
        }
        else if (IsLoadingOrders)
        {
            <div class="profile-orders-loading" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                Henter dine ordrer...
            </div>
        }
        else if (OrderHistory.Count == 0)
        {
            <div class="profile-orders-empty">
                <i class="bi bi-bag" aria-hidden="true"></i>
                <strong>Du har ikke nogen ordrer endnu</strong>
                <span>Dine køb vises her, når du har gennemført en bestilling.</span>
                <a class="page-button-outline" href="/keyboards">Find produkter</a>
            </div>
        }
        else
        {
            <div class="profile-order-list">
                @foreach (OrderHistoryEntry order in OrderHistory)
                {
                    <details class="profile-order-card">
                        <summary>
                            <span class="profile-order-icon"><i class="bi bi-bag-check" aria-hidden="true"></i></span>
                            <span class="profile-order-main">
                                <strong>Ordre #@order.ID.ToString("N")[..8].ToUpperInvariant()</strong>
                                <span>@order.DateCreated.ToLocalTime().ToString("dd-MM-yyyy 'kl.' HH:mm") · @order.ItemsAmount vare@(order.ItemsAmount == 1 ? "" : "r")</span>
                            </span>
                            <span class="profile-order-total">@order.TotalPrice.ToString("N2") kr.</span>
                            <span class="profile-order-status">@FormatOrderStatus(order.Status)</span>
                            <i class="bi bi-chevron-down profile-order-chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="profile-order-details">
                            <div class="profile-order-address">
                                <span>Leveringsadresse</span>
                                <strong>@order.ShippingAddress</strong>
                            </div>
                            <div class="table-responsive">
                                <table class="table profile-order-items">
                                    <thead>
                                        <tr>
                                            <th>Produkt</th>
                                            <th>Antal</th>
                                            <th>Stykpris</th>
                                            <th>Beløb</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (OrderHistoryItem item in order.Items)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.UnitPrice.ToString("N2") kr.</td>
                                                <td>@((item.UnitPrice * item.Quantity).ToString("N2")) kr.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </details>
                }
            </div>
        }
    </section>

    @if (IsCustomer)
    {
        <section class="employee-form-section profile-delete-section mt-4">
            <h3>Slet min konto</h3>
            <p>Hvis du sletter din konto, kan du ikke længere logge ind.</p>
            <button type="button"
                    class="profile-delete-trigger"
                    @onclick="() => ShowDeleteConfirmation = true">
                Slet min profil
            </button>
        </section>
    }

    }

</div>


@if (ShowPersonalPopup)
{
    <div class="profile-modal-overlay">

        <div class="profile-modal">

            <h3>Rediger personlige oplysninger</h3>

            <hr />

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Fornavn</label>
                    <input class="form-control"
                           @bind="EditFirstName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Efternavn</label>
                    <input class="form-control"
                           @bind="EditLastName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">E-mail</label>
                    <input type="email"
                           class="form-control"
                           @bind="EditEmail" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Telefonnummer</label>
                    <input type="tel"
                           class="form-control"
                           maxlength="8"
                           @bind="EditPhoneNumber" />
                </div>

            </div>

            @if (!string.IsNullOrEmpty(PersonalError))
            {
                <p class="text-danger mt-3">
                    @PersonalError
                </p>
            }

            <div class="profile-modal-actions">

                <button type="button"
                        class="page-button-outline"
                        @onclick="ClosePersonalPopup">
                    Annuller
                </button>

                <button type="button"
                        class="page-button"
                        disabled="@IsSavingPersonalInfo"
                        @onclick="SavePersonalInfoAsync">
                    @(IsSavingPersonalInfo ? "Gemmer..." : "Gem ændringer")
                </button>

            </div>

        </div>

    </div>
}


@if (ShowAddressPopup)
{
    <div class="profile-modal-overlay">

        <div class="profile-modal">

            <h3>Rediger adresse</h3>

            <hr />

            <div class="row g-3">

                <div class="col-md-8">
                    <label class="form-label">Adresse</label>
                    <input class="form-control"
                           @bind="EditStreetAddress" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Lejlighed</label>
                    <input class="form-control"
                           @bind="EditApartment" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Postnummer</label>
                    <input class="form-control"
                           maxlength="4"
                           @bind="EditPostalCode" />
                </div>

                <div class="col-md-8">
                    <label class="form-label">By</label>
                    <input class="form-control"
                           @bind="EditCity" />
                </div>

            </div>

            @if (!string.IsNullOrEmpty(AddressError))
            {
                <p class="text-danger mt-3">
                    @AddressError
                </p>
            }

            <div class="profile-modal-actions">

                <button type="button"
                        class="page-button-outline"
                        disabled="@IsSavingAddress"
                        @onclick="CloseAddressPopup">
                    Annuller
                </button>

                <button type="button"
                        class="page-button"
                        disabled="@IsSavingAddress"
                        @onclick="SaveAddressAsync">
                    @(IsSavingAddress ? "Gemmer..." : "Gem ændringer")
                </button>

            </div>

        </div>

    </div>
}

@if (ShowDeleteConfirmation)
{
    <div class="employee-modal-overlay">
        <div class="employee-modal employee-delete-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="delete-own-account-title">
            <div class="employee-delete-icon">
                <i class="bi bi-trash3" aria-hidden="true"></i>
            </div>
            <h2 id="delete-own-account-title">Slet min profil</h2>
            <p class="employee-delete-description">
                Er du sikker på, at du vil slette din kundekonto?
            </p>
            <p class="employee-delete-warning">Du bliver logget ud, og handlingen kan ikke fortrydes.</p>
            <div class="employee-delete-actions">
                <button type="button"
                        class="page-button-outline"
                        @onclick="() => ShowDeleteConfirmation = false">
                    Annuller
                </button>
                <form method="post" action="/api/auth/delete-account">
                    <AntiforgeryToken />
                    <button type="submit" class="employee-delete-button">
                        Ja, slet min profil
                    </button>
                </form>
            </div>
        </div>
    </div>
}


@code {
    private string FirstName = "";
    private string LastName = "";
    private string Email = "";
    private string PhoneNumber = "";
    private string StreetAddress = "";
    private string Apartment = "";
    private string PostalCode = "";
    private string City = "";
    private bool IsLoading = true;
    private bool IsSavingPersonalInfo;
    private bool IsSavingAddress;
    private bool IsCustomer;
    private bool ShowDeleteConfirmation;
    private bool IsLoadingOrders;
    private string? LoadError;
    private string? AccountDeleteError;
    private string? OrderHistoryError;
    private Guid? CurrentUserId;
    private List<OrderHistoryEntry> OrderHistory = [];

    private bool ShowPersonalPopup = false;
    private bool ShowAddressPopup = false;

    private string PersonalError = "";
    private string AddressError = "";

    private string EditFirstName = "";
    private string EditLastName = "";
    private string EditEmail = "";
    private string EditPhoneNumber = "";

    private string EditStreetAddress = "";
    private string EditApartment = "";
    private string EditPostalCode = "";
    private string EditCity = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!Guid.TryParse(
                    authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
                    out Guid userId))
            {
                LoadError = "Kunne ikke finde den indloggede bruger. Log ind igen.";
                return;
            }

            CurrentUserId = userId;
            string accountDeleteResult = Microsoft.AspNetCore.WebUtilities.QueryHelpers
                .ParseQuery(new Uri(Navigation.Uri).Query)
                .TryGetValue("accountDelete", out var result)
                ? result.ToString()
                : "";
            AccountDeleteError = accountDeleteResult switch
            {
                "failed" => "Din konto kunne ikke slettes. Den kan være knyttet til eksisterende ordrer eller andre data.",
                "not-allowed" => "Kun kunder kan slette deres egen konto.",
                _ => null
            };

            User user = await UserService.GetByID(userId);
            IsCustomer = user.Role == UserRole.Customer;
            FirstName = user.FirstName;
            LastName = user.LastName;
            Email = user.Email;
            PhoneNumber = user.PhoneNumber;
            StreetAddress = user.StreetAddress;
            Apartment = user.Apartment ?? "";
            PostalCode = user.PostalCode;
            City = user.City;
            await LoadOrderHistoryAsync(userId);
        }
        catch (NotFoundException exception)
        {
            Logger.LogWarning(exception, "Could not find the signed-in user profile.");
            LoadError = "Dine brugeroplysninger blev ikke fundet. Log ind igen.";
        }
        catch (Exception exception) when (exception is DbException or FormatException or InvalidOperationException)
        {
            Logger.LogError(exception, "Could not load the signed-in user profile.");
            LoadError = "Dine brugeroplysninger kunne ikke indlæses. Prøv igen senere.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadOrderHistoryAsync(Guid userId)
    {
        IsLoadingOrders = true;
        OrderHistoryError = null;
        try
        {
            OrderHistory = await OrderService.GetCustomerOrderHistoryAsync(userId);
        }
        catch (DbException exception)
        {
            Logger.LogError(exception, "Could not load order history for user {UserId}.", userId);
            OrderHistoryError = "Dine ordrer kunne ikke indlæses lige nu. Prøv igen senere.";
        }
        finally
        {
            IsLoadingOrders = false;
        }
    }

    private static string FormatOrderStatus(string status) =>
        status switch
        {
            "Placed" => "Modtaget",
            "Processing" => "Behandles",
            "Shipped" => "Afsendt",
            "Completed" => "Afsluttet",
            "Cancelled" => "Annulleret",
            _ => status
        };

    private void OpenPersonalPopup()
    {
        EditFirstName = FirstName;
        EditLastName = LastName;
        EditEmail = Email;
        EditPhoneNumber = PhoneNumber;

        PersonalError = "";

        ShowPersonalPopup = true;
    }


    private void ClosePersonalPopup()
    {
        ShowPersonalPopup = false;
        PersonalError = "";
    }


    private async Task SavePersonalInfoAsync()
    {
        PersonalError = "";

        if (string.IsNullOrWhiteSpace(EditFirstName) ||
            string.IsNullOrWhiteSpace(EditLastName) ||
            string.IsNullOrWhiteSpace(EditEmail) ||
            string.IsNullOrWhiteSpace(EditPhoneNumber))
        {
            PersonalError = "Alle felter skal udfyldes.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(
            EditFirstName.Trim(),
            @"^[\p{L}]+(?:[ '-][\p{L}]+)*$") ||
            !System.Text.RegularExpressions.Regex.IsMatch(
            EditLastName.Trim(),
            @"^[\p{L}]+(?:[ '-][\p{L}]+)*$"))
        {
            PersonalError = "Fornavn og efternavn må kun indeholde bogstaver, mellemrum, bindestreger og apostroffer.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(
            EditEmail.Trim(),
            @"^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"))
        {
            PersonalError = "Indtast en gyldig e-mailadresse.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(
            EditPhoneNumber.Trim(),
            @"^\d{8}$"))
        {
            PersonalError = "Telefonnummeret skal indeholde præcis 8 cifre.";
            return;
        }

        if (CurrentUserId is not Guid userId)
        {
            PersonalError = "Kunne ikke finde din konto. Log ind igen.";
            return;
        }

        EditFirstName = EditFirstName.Trim();
        EditLastName = EditLastName.Trim();
        EditEmail = EditEmail.Trim();
        EditPhoneNumber = EditPhoneNumber.Trim();

        IsSavingPersonalInfo = true;
        try
        {
            await UserService.UpdateProfileAsync(
                userId,
                EditFirstName,
                EditLastName,
                EditEmail,
                EditPhoneNumber);

            FirstName = EditFirstName;
            LastName = EditLastName;
            Email = EditEmail;
            PhoneNumber = EditPhoneNumber;
            ClosePersonalPopup();
        }
        catch (InvalidOperationException exception)
        {
            PersonalError = exception.Message;
        }
        catch (NotFoundException exception)
        {
            Logger.LogWarning(exception, "Could not save profile for user {UserId}.", userId);
            PersonalError = "Din konto blev ikke fundet. Log ind igen.";
        }
        catch (Exception exception) when (exception is DbException or FormatException)
        {
            Logger.LogError(exception, "Could not update personal profile information for user {UserId}.", userId);
            PersonalError = "Dine oplysninger kunne ikke gemmes. Prøv igen.";
        }
        finally
        {
            IsSavingPersonalInfo = false;
        }
    }


    private void OpenAddressPopup()
    {
        EditStreetAddress = StreetAddress;
        EditApartment = Apartment;
        EditPostalCode = PostalCode;
        EditCity = City;

        AddressError = "";

        ShowAddressPopup = true;
    }

    private void CloseAddressPopup()
    {
        ShowAddressPopup = false;
        AddressError = "";
    }


    private async Task SaveAddressAsync()
    {
        AddressError = "";

        EditStreetAddress = EditStreetAddress.Trim();
        EditApartment = EditApartment.Trim();
        EditPostalCode = EditPostalCode.Trim();
        EditCity = EditCity.Trim();

        if (string.IsNullOrWhiteSpace(EditStreetAddress) ||
            string.IsNullOrWhiteSpace(EditPostalCode) ||
            string.IsNullOrWhiteSpace(EditCity))
        {
            AddressError = "Adresse, postnummer og by skal udfyldes.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(EditStreetAddress, @"^(?=.*\p{L})(?=.*\d)[\p{L}\d\s.'/-]+$"))
        {
            AddressError = "Indtast en gyldig adresse med vejnavn og husnummer.";
            return;
        }

        if (!System.Text.RegularExpressions.Regex.IsMatch(EditPostalCode, @"^\d{4}$"))
        {
            AddressError = "Postnummeret skal indeholde præcis 4 cifre.";
            return;
        }

        if (CurrentUserId is not Guid userId)
        {
            AddressError = "Kunne ikke finde din konto. Log ind igen.";
            return;
        }

        IsSavingAddress = true;
        try
        {
            await UserService.UpdateProfileAddressAsync(
                userId,
                EditStreetAddress,
                string.IsNullOrWhiteSpace(EditApartment) ? null : EditApartment,
                EditPostalCode,
                EditCity);

            StreetAddress = EditStreetAddress;
            Apartment = EditApartment;
            PostalCode = EditPostalCode;
            City = EditCity;
            CloseAddressPopup();
        }
        catch (NotFoundException exception)
        {
            Logger.LogWarning(exception, "Could not save address for user {UserId}.", userId);
            AddressError = "Din konto blev ikke fundet. Log ind igen.";
        }
        catch (Exception exception) when (exception is DbException or InvalidOperationException)
        {
            Logger.LogError(exception, "Could not update address for user {UserId}.", userId);
            AddressError = "Din adresse kunne ikke gemmes. Prøv igen.";
        }
        finally
        {
            IsSavingAddress = false;
        }
    }



    private void GoToChangePassword()
    {
        Navigation.NavigateTo("/change-password");
    }


}