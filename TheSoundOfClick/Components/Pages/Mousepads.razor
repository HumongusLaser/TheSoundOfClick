@page "/mousepads"
@rendermode InteractiveServer
@inject ProductService ProductService
@inject CartService CartService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Musemåtter | The Sound Of Click</PageTitle>

<div class="page-content">
    <h1>Musemåtter</h1>
    <p class="page-description">Find den perfekte musemåtte til dit gaming-setup.</p>
    <hr />

    <div class="row g-3 mb-4 mt-4">
        <div class="col-md-4">
            <label class="form-label">Sortér efter</label>
            <select class="form-select" @bind="SelectedSort">
                <option value="default">Standard</option>
                <option value="price-asc">Pris: Laveste først</option>
                <option value="price-desc">Pris: Højeste først</option>
                <option value="name">Navn: A–Å</option>
            </select>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(CartMessage))
    {
        <p class="text-success" role="status">@CartMessage</p>
    }

    <div class="row g-4 mt-3">
        @if (IsLoading)
        {
            <p>Indlæser musemåtter...</p>
        }
        else if (SortedMousepads.Any())
        {
            @foreach (var mousepad in SortedMousepads)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="product-card">
                        <div class="product-image-placeholder">
                            <i class="bi bi-image"></i>
                            <p>Produktbillede kommer snart</p>
                        </div>
                        <div class="product-info">
                            <h3>@mousepad.Name</h3>
                            <p>@mousepad.Description</p>
                            <div class="product-price">@mousepad.Price.ToString("N2") kr.</div>
                            <div class="product-actions">
                                <button type="button"
                                        class="page-button-outline"
                                        @onclick="() => NavigateToProduct(mousepad.ID)">
                                    Se produkt
                                </button>
                                <button type="button"
                                        class="page-button"
                                        disabled="@(mousepad.Stock <= 0)"
                                        @onclick="() => AddToCartAsync(mousepad)">
                                    Læg i kurv
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="employee-form-section text-center">
                    <h3>Ingen musemåtter fundet</h3>
                    <p class="page-description">Der er desværre ingen musemåtter tilgængelige lige nu.</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Product> Products = [];
    private string SelectedSort = "default";
    private string? CartMessage;
    private bool IsLoading = true;

    private IEnumerable<Product> SortedMousepads =>
        SelectedSort switch
        {
            "price-asc" => Products.OrderBy(mousepad => mousepad.Price),
            "price-desc" => Products.OrderByDescending(mousepad => mousepad.Price),
            "name" => Products.OrderBy(mousepad => mousepad.Name),
            _ => Products
        };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Products = await ProductService.GetAllProductsAsync(null, "mousepad", 100);
        }
        catch (NotFoundException)
        {
            Products = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task AddToCartAsync(Product product)
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(
            authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out Guid userId))
        {
            string returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            return;
        }

        await CartService.AddToCartAsync(product.ID, userId);
        CartMessage = $"{product.Name} blev lagt i kurven.";
    }

    private void NavigateToProduct(Guid productId)
    {
        Navigation.NavigateTo($"/product/{productId}");
    }
}
