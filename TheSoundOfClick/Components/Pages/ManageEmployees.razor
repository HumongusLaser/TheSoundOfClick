@page "/manage-employees"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize(Roles = "Admin")] *@

<PageTitle>Administrer medarbejdere</PageTitle>

<div class="page-content">
 
    <h1>Administrer medarbejdere</h1>

    <p class="page-description">
        Her kan du oprette og administrere medarbejdere og administratorer.
    </p>

    <hr />

    <div class="mt-4 mb-4">

        <h4>Søg efter bruger</h4>

        <input type="text"
               class="form-control"
               placeholder="Søg efter ID, fornavn eller efternavn..."
               @bind="SearchText"
               @bind:event="oninput" />

    </div>


    <div class="mb-4">

        <NavLink class="page-button"
                 href="/manage-employees/create">
            + Opret medarbejder
        </NavLink>

    </div>

    <div class="row g-3">

        <div class="col-md-6">

            <NavLink class="page-button-outline w-100"
                     href="/manage-employees/admins">
                Vis alle admins
            </NavLink>

        </div>

        <div class="col-md-6">

            <NavLink class="page-button-outline w-100"
                     href="/manage-employees/employees">
                Vis alle medarbejdere
            </NavLink>

        </div>

    </div>

</div>

@code {

    private string SearchText = "";

}