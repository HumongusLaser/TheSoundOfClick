@page "/manage-employees"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization

@* @attribute [Authorize(Roles = "Admin")] *@

<PageTitle>Administrer medarbejdere</PageTitle>

<div class="page-content">

    <h1>Administrer medarbejdere</h1>

    <p class="page-description">
        Her kan du oprette og administrere medarbejdere og administratorer.
    </p>

    <hr />

    <div class="mt-4 mb-4">

        <h4>Søg efter bruger</h4>

        <input type="text"
               class="form-control"
               placeholder="Søg efter ID, fornavn eller efternavn..."
               @bind="SearchText"
               @bind:event="oninput" />

        @if (!string.IsNullOrWhiteSpace(SearchText))
        {
            <section class="employee-form-section mb-4">

                <h3>Søgeresultater</h3>

                @if (FilteredUsers.Any())
                {
                    <div class="table-responsive">

                        <table class="table admin-table">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Fornavn</th>
                                    <th>Efternavn</th>
                                    <th>Rolle</th>
                                    <th>Handlinger</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr>
                                        <td>@user.Id</td>
                                        <td>@user.FirstName</td>
                                        <td>@user.LastName</td>
                                        <td>@user.Role</td>

                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-info me-2"
                                                    title="Rediger bruger"
                                                    @onclick="() => EditUser(user)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Slet bruger"
                                                    @onclick="() => DeleteUser(user)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <p class="page-description mt-3">
                        Ingen brugere matcher din søgning.
                    </p>
                }

            </section>
        }

    </div>

    <div class="mb-4">

        <NavLink class="page-button"
                 href="/manage-employees/create">
            + Opret medarbejder
        </NavLink>

    </div>

    <div class="row g-3">

        <div class="col-md-6">
            <NavLink class="page-button-outline w-100"
                     href="/manage-employees/admins">
                Vis alle admins
            </NavLink>
        </div>

        <div class="col-md-6">
            <NavLink class="page-button-outline w-100"
                     href="/manage-employees/employees">
                Vis alle medarbejdere
            </NavLink>
        </div>

    </div>

    @if (EditingUser is not null)
    {
        <div class="employee-modal-overlay">

            <div class="employee-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Rediger bruger">

                <h2>Rediger bruger</h2>

                <p class="page-description">
                    Her kan du ændre oplysningerne for
                    @EditingUser.FirstName @EditingUser.LastName.
                </p>

                <h3>Personlige oplysninger</h3>

                <div class="row g-3 mt-2">

                    <div class="col-md-6">
                        <label class="form-label">Fornavn</label>
                        <input class="form-control"
                               @bind="EditingUser.FirstName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Efternavn</label>
                        <input class="form-control"
                               @bind="EditingUser.LastName" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">E-mail</label>
                        <input type="email"
                               class="form-control"
                               @bind="EditingUser.Email" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">Adresse</label>
                        <input class="form-control"
                               @bind="EditingUser.StreetAddress" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Lejlighed (valgfrit)</label>
                        <input class="form-control"
                               @bind="EditingUser.Apartment" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Postnummer</label>
                        <input class="form-control"
                               maxlength="4"
                               @bind="EditingUser.PostalCode" />
                    </div>

                    <div class="col-md-8">
                        <label class="form-label">By</label>
                        <input class="form-control"
                               @bind="EditingUser.City" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Telefonnummer</label>
                        <input type="tel"
                               class="form-control"
                               maxlength="8"
                               @bind="EditingUser.PhoneNumber" />
                    </div>

                </div>

                <hr class="my-4" />

                <h3>Brugerrolle</h3>

                <div class="mb-4 mt-3">

                    <label class="form-label">Rolle</label>

                    <select class="form-select"
                            @bind="EditingUser.Role">
                        <option value="Admin">Admin</option>
                        <option value="Employee">Employee</option>
                    </select>

                </div>

                @if (!string.IsNullOrEmpty(EditError))
                {
                    <p class="text-danger" role="alert">
                        @EditError
                    </p>
                }

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <button type="button"
                            class="page-button"
                            @onclick="SaveChanges">
                        Gem ændringer
                    </button>

                    <button type="button"
                            class="page-button-outline"
                            @onclick="CancelEdit">
                        Annuller
                    </button>

                </div>

            </div>

        </div>
    }
    @if (DeletingUser is not null)
    {
        <div class="employee-modal-overlay">

            <div class="employee-modal employee-delete-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Bekræft sletning">

                <div class="employee-delete-icon">
                    <i class="bi bi-trash3"></i>
                </div>

                <h2>Slet bruger</h2>

                <p class="employee-delete-description">
                    Er du sikker på, at du vil slette
                    <strong>
                        @DeletingUser.FirstName @DeletingUser.LastName
                    </strong>?
                </p>

                <p class="employee-delete-warning">
                    Denne handling kan ikke fortrydes.
                </p>

                <div class="employee-delete-actions">

                    <button type="button"
                            class="page-button-outline"
                            @onclick="CancelDelete">
                        Annuller
                    </button>

                    <button type="button"
                            class="employee-delete-button"
                            @onclick="ConfirmDelete">
                        Ja, slet bruger
                    </button>

                </div>

            </div>

        </div>
    }

    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="employee-form-message" role="status">
            @Message
        </p>
    }

</div>

@code {

    private string SearchText = "";
    private string Message = "";
    private string EditError = "";

    private SearchUser? EditingUser;
    private SearchUser? DeletingUser;

    private List<SearchUser> Users = new()
    {
