@page "/register"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

<AuthCard Title="Opret din konto"
          Description="Bliv en del af The Sound Of Click"
          Wide="true">

        <form class="auth-form" method="post" action="/api/auth/register">
            <AntiforgeryToken />

            <h3 class="auth-section-title">Personlige oplysninger</h3>

            <div class="auth-row">

                <div class="auth-field">
                    <label for="firstName">Fornavn</label>
                    <input id="firstName"
                           type="text"
                           name="FirstName"
                           placeholder="Fornavn"
                           autocomplete="given-name"
                           required />
                </div>

                <div class="auth-field">
                    <label for="lastName">Efternavn</label>
                    <input id="lastName"
                           type="text"
                           name="LastName"
                           placeholder="Efternavn"
                           autocomplete="family-name"
                           required />
                </div>

            </div>

            <div class="auth-field">
                <label for="email">Emailadresse</label>
                <input id="email"
                       type="email"
                       name="Email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       required />
            </div>

            <h3 class="auth-section-title">Adresse</h3>

            <div class="auth-field">
                <label for="street">Vejnavn og husnummer</label>
                <input id="street"
                       type="text"
                       name="StreetAddress"
                       placeholder="Eksempel: Hovedgaden 12"
                       autocomplete="street-address"
                       required />
            </div>

            <div class="auth-field">
                <label for="apartment">Etage og dør (valgfrit)</label>
                <input id="apartment"
                       type="text"
                       name="Apartment"
                       placeholder="Eksempel: 2. th."
                       />
            </div>

            <div class="auth-row">

                <div class="auth-field">
                    <label for="postalCode">Postnummer</label>
                    <input id="postalCode"
                           type="text"
                           name="PostalCode"
                           inputmode="numeric"
                           maxlength="4"
                           placeholder="1234"
                           autocomplete="postal-code"
                           required />
                </div>

                <div class="auth-field">
                    <label for="city">By</label>
                    <input id="city"
                           type="text"
                           name="City"
                           placeholder="By"
                           autocomplete="address-level2"
                           required />
                </div>

            </div>

            <div class="auth-field">
                <label for="phone">Telefonnummer</label>

                <div class="auth-phone">
                    <span>+45</span>

                    <input id="phone"
                           type="tel"
                           name="PhoneNumber"
                           inputmode="numeric"
                           maxlength="8"
                           placeholder="12345678"
                           autocomplete="tel-national"
                           required />
                </div>
            </div>

            <!-- Adgangskode -->
            <h3 class="auth-section-title">Sikkerhed</h3>

            <div class="auth-field">
                <label for="password">Adgangskode</label>

                <div class="auth-password-requirements">
                    <p>Din adgangskode skal indeholde:</p>
                    <ul>
                        <li>Mindst 16 tegn</li>
                        <li>Mindst 2 store bogstaver</li>
                        <li>Mindst 2 tal</li>
                        <li>Mindst 2 specialtegn</li>
                    </ul>
                </div>

                <input id="password"
                       type="password"
                       name="Password"
                       placeholder="Opret en adgangskode"
                       autocomplete="new-password"
                       required />
            </div>

            <div class="auth-field">
                <label for="confirmPassword">Gentag adgangskode</label>
                <input id="confirmPassword"
                       type="password"
                       name="ConfirmPassword"
                       placeholder="Gentag din adgangskode"
                       autocomplete="new-password"
                       required />
            </div>

            <button type="submit" class="auth-button">
                Opret konto
            </button>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="auth-message" role="status">
                    @ErrorMessage
                </p>
            }

            <div class="auth-footer">
                <p>
                    Har du allerede en konto?
                    <a href="/login">Log ind</a>
                </p>
            </div>
        </form>

    </AuthCard>

</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string? ErrorMessage => Error switch
    {
        "first-name" => "Du skal skrive dit fornavn.",
        "last-name" => "Du skal skrive dit efternavn.",
        "email" => "Du skal skrive en gyldig emailadresse.",
        "email-taken" => "Der findes allerede en konto med denne emailadresse.",
        "address" => "Du skal skrive vejnavn og husnummer.",
        "postal-code" => "Du skal skrive et gyldigt postnummer med 4 tal.",
        "city" => "Du skal skrive din by.",
        "phone" => "Du skal skrive et gyldigt telefonnummer.",
        "password" => "Dit password overholder ikke kravene.",
        "password-mismatch" => "Dine passwords er ikke ens.",
        "failed" => "Der opstod en fejl. Du kan ikke oprette en bruger lige nu.",
        _ => null
    };
}