@page "/register"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

<AuthCard Title="Opret din konto"
          Description="Bliv en del af The Sound Of Click"
          Wide="true">

        <div class="auth-form">

            <h3 class="auth-section-title">Personlige oplysninger</h3>

            <div class="auth-row">

                <div class="auth-field">
                    <label for="firstName">Fornavn</label>
                    <input id="firstName"
                           type="text"
                           placeholder="Fornavn"
                           autocomplete="given-name"
                           @bind="FirstName" />
                </div>

                <div class="auth-field">
                    <label for="lastName">Efternavn</label>
                    <input id="lastName"
                           type="text"
                           placeholder="Efternavn"
                           autocomplete="family-name"
                           @bind="LastName" />
                </div>

            </div>

            <div class="auth-field">
                <label for="email">Emailadresse</label>
                <input id="email"
                       type="email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       @bind="Email" />
            </div>

            <h3 class="auth-section-title">Adresse</h3>

            <div class="auth-field">
                <label for="street">Vejnavn og husnummer</label>
                <input id="street"
                       type="text"
                       placeholder="Eksempel: Hovedgaden 12"
                       autocomplete="street-address"
                       @bind="StreetAddress" />
            </div>

            <div class="auth-field">
                <label for="apartment">Etage og dør (valgfrit)</label>
                <input id="apartment"
                       type="text"
                       placeholder="Eksempel: 2. th."
                       @bind="Apartment" />
            </div>

            <div class="auth-row">

                <div class="auth-field">
                    <label for="postalCode">Postnummer</label>
                    <input id="postalCode"
                           type="text"
                           inputmode="numeric"
                           maxlength="4"
                           placeholder="1234"
                           autocomplete="postal-code"
                           @bind="PostalCode" />
                </div>

                <div class="auth-field">
                    <label for="city">By</label>
                    <input id="city"
                           type="text"
                           placeholder="By"
                           autocomplete="address-level2"
                           @bind="City" />
                </div>

            </div>

            <div class="auth-field">
                <label for="phone">Telefonnummer</label>

                <div class="auth-phone">
                    <span>+45</span>

                    <input id="phone"
                           type="tel"
                           inputmode="numeric"
                           maxlength="8"
                           placeholder="12345678"
                           autocomplete="tel-national"
                           @bind="PhoneNumber" />
                </div>
            </div>

            <!-- Adgangskode -->
            <h3 class="auth-section-title">Sikkerhed</h3>

            <div class="auth-field">
                <label for="password">Adgangskode</label>

                <div class="auth-password-requirements">
                    <p>Din adgangskode skal indeholde:</p>
                    <ul>
                        <li>Mindst 16 tegn</li>
                        <li>Mindst 2 store bogstaver</li>
                        <li>Mindst 2 tal</li>
                        <li>Mindst 2 specialtegn</li>
                    </ul>
                </div>

                <input id="password"
                       type="password"
                       placeholder="Opret en adgangskode"
                       autocomplete="new-password"
                       @bind="Password" />
            </div>

            <div class="auth-field">
                <label for="confirmPassword">Gentag adgangskode</label>
                <input id="confirmPassword"
                       type="password"
                       placeholder="Gentag din adgangskode"
                       autocomplete="new-password"
                       @bind="ConfirmPassword" />
            </div>

            <button type="button"
                    class="auth-button"
                    @onclick="RegisterUser">
                Opret konto
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="auth-message" role="status">
                    @Message
                </p>
            }

            <div class="auth-footer">
                <p>
                    Har du allerede en konto?
                    <a href="/login">Log ind</a>
                </p>
            </div>

        </div>

    </AuthCard>

</div>

@code {
    private string FirstName = "";
    private string LastName = "";
    private string Email = "";
    private string StreetAddress = "";
    private string Apartment = "";
    private string PostalCode = "";
    private string City = "";
    private string PhoneNumber = "";
    private string Password = "";
    private string ConfirmPassword = "";
    private string Message = "";

    ValidationService validationService = new ValidationService();

    private void RegisterUser()
    {
        Message = "";

        if (!validationService.IsValidName(FirstName))
        {
            Message = "Du skal skrive dit fornavn.";
            return;
        }
        if (!validationService.IsValidName(LastName))
        {
            Message = "Du skal skrive dit efternavn.";
            return;
        }

        if (!validationService.IsValidEmail(Email))
        {
            Message = "Du skal skrive en gyldig emailadresse.";
            return;
        }
        if (!validationService.IsValidAddress(StreetAddress))
        {
            Message = "Du skal skrive vejnavn og husnummer.";
            return;
        }

        if (!validationService.IsValidPostalCode(PostalCode))
        {
            Message = "Du skal skrive et gyldigt postnummer med 4 tal.";
            return;
        }

        if (!validationService.IsValidCity(City))
        {
            Message = "Du skal skrive din by.";
            return;
        }

        if (!validationService.IsValidPhoneNumber(PhoneNumber))
        {
            Message = "Du skal skrive et gyldigt telefonnummer.";
            return;
        }

        if (!validationService.IsValidPassword(Password))
        {
            Message = "Dit password overholder ikke kravene.";
            return;
        }

        if (Password != ConfirmPassword)
        {
            Message = "Dine passwords er ikke ens.";
            return;
        }
        
        Message = "Alle oplysninger er godkendt. Brugeren er endnu ikke oprettet.";
    }

  

}