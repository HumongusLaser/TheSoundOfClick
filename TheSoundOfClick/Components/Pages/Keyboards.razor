@page "/keyboards"
@rendermode InteractiveServer

<PageTitle>Tastaturer | The Sound Of Click</PageTitle>

<div class="page-content">

    <h1>Tastaturer</h1>

    <p class="page-description">
        Find dit næste gaming-tastatur blandt vores udvalg.
    </p>

    <hr />

    <div class="row g-3 mb-4 mt-4">

        <div class="col-md-4">

            <label class="form-label">Forbindelse</label>

            <select class="form-select" @bind="SelectedConnection">
                <option value="all">Alle</option>
                <option value="wireless">Trådløs</option>
                <option value="wired">Med kabel</option>
            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">Størrelse</label>

            <select class="form-select" @bind="SelectedSize">
                <option value="all">Alle størrelser</option>
                <option value="60%">60 %</option>
                <option value="75%">75 %</option>
                <option value="100%">100 %</option>
            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">Sortér efter</label>

            <select class="form-select" @bind="SelectedSort">
                <option value="default">Standard</option>
                <option value="price-asc">Pris: Laveste først</option>
                <option value="price-desc">Pris: Højeste først</option>
                <option value="name">Navn: A–Å</option>
            </select>

        </div>

    </div>

    <div class="row g-4 mt-3">

        @if (FilteredKeyboards.Any())
        {
            @foreach (var keyboard in FilteredKeyboards)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="product-card">

                        <div class="product-image">

                            <img src="@keyboard.Image"
                                 alt="@keyboard.Name" />

                        </div>

                        <div class="product-info">

                            <h3>@keyboard.Name</h3>

                            <p>@keyboard.Description</p>

                            <div class="product-price">
                                @keyboard.Price.ToString("N2") kr.
                            </div>

                            <div class="product-actions">

                                <button type="button"
                                        class="page-button-outline">
                                    Se produkt
                                </button>

                                <button type="button"
                                        class="page-button">
                                    Læg i kurv
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="employee-form-section text-center">

                    <h3>Ingen produkter fundet</h3>

                    <p class="page-description">
                        Der er desværre ingen tastaturer, der matcher dine valgte filtre.
                    </p>

                    <button type="button"
                            class="page-button-outline mt-3"
                            @onclick="ResetFilters">
                        Nulstil filtre
                    </button>

                </div>

            </div>
        }

    </div>

</div>

@code {


    private string SelectedConnection = "all";
    private string SelectedSize = "all";
    private string SelectedSort = "default";



    private List<KeyboardProduct> Keyboardsss = new()
    {
        new KeyboardProduct
        {
            Name = "Gaming Keyboard RGB",
            Description = "Mekanisk gaming-tastatur med RGB-belysning.",
            Price = 699,
            Image = "/images/keyboards/keyboard1.jpg",
            IsWireless = false,
            Size = "100%"
        },

        new KeyboardProduct
        {
            Name = "Wireless Mechanical Keyboard",
            Description = "Trådløst mekanisk tastatur med kompakt design.",
            Price = 899,
            Image = "/images/keyboards/keyboard2.jpg",
            IsWireless = true,
            Size = "75%"
        },

        new KeyboardProduct
        {
            Name = "Compact Gaming Keyboard",
            Description = "Kompakt gaming-tastatur med hurtige switches.",
            Price = 549,
            Image = "/images/keyboards/keyboard3.jpg",
            IsWireless = false,
            Size = "60%"
        }
    };



    private IEnumerable<KeyboardProduct> SortedKeyboards =>
        SelectedSort switch
        {
            "price-asc" => Keyboardsss.OrderBy(k => k.Price),

            "price-desc" => Keyboardsss.OrderByDescending(k => k.Price),

            "name" => Keyboardsss.OrderBy(k => k.Name),

            _ => Keyboardsss
        };



    private IEnumerable<KeyboardProduct> FilteredKeyboards
    {
        get
        {
            var keyboards = SortedKeyboards;

            if (SelectedConnection == "wireless")
            {
                keyboards = keyboards.Where(k => k.IsWireless);
            }
            else if (SelectedConnection == "wired")
            {
                keyboards = keyboards.Where(k => !k.IsWireless);
            }

            if (SelectedSize != "all")
            {
                keyboards = keyboards.Where(k => k.Size == SelectedSize);
            }

            return keyboards;
        }
    }

    private void ResetFilters()
    {
        SelectedConnection = "all";
        SelectedSize = "all";
        SelectedSort = "default";
    }


    // MIDLERTIDIG PRODUKTKLASSE

    private class KeyboardProduct
    {
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";

        public decimal Price { get; set; }

        public string Image { get; set; } = "";

        public bool IsWireless { get; set; }

        public string Size { get; set; } = "";
    }
}