@page "/products"
@rendermode InteractiveServer

@inject ProductService ProductService
@inject ILogger<Products> Logger
@using System.Globalization
@using System.Reflection
@using System.Data.Common
@using Microsoft.AspNetCore.Components.Web.Virtualization

@using Microsoft.AspNetCore.RateLimiting

@attribute [EnableRateLimiting("products")]

@* @attribute [Authorize(Roles = "Employee,Admin")] *@

<PageTitle>Administrer produkter | The Sound Of Click</PageTitle>

<div class="page-content">

    <h1>Administrer produkter</h1>

    <p class="page-description">
        Her kan du oprette, søge efter og administrere produkter.
    </p>

    <hr />

    @if (!string.IsNullOrEmpty(CreateSuccess))
    {
        <p class="text-success" role="status">@CreateSuccess</p>
    }

    <div class="employee-form-section mt-4">

        <h3>Tilføj produkt</h3>

        <p class="page-description">
            Opret et nyt produkt til webshoppen.
        </p>

        <button type="button"
                class="page-button mt-3"
                @onclick="OpenCreatePopup">
            + Tilføj produkt
        </button>

    </div>



    <div class="employee-form-section mt-4">

        <h3>Find produkt</h3>

        <div class="row g-3 mt-2">

            <div class="col-12">

                <label class="form-label">Søg efter produktnavn eller ID</label>

                <input class="form-control"
                       placeholder="Indtast produktnavn eller ID..."
                       @bind="SearchText"
                       @bind:event="oninput"
                       @bind:after="RefreshProductListAsync" />

            </div>

            <div class="col-md-6">

                <label class="form-label">Kategori</label>

                <select class="form-select"
                        @bind="SelectedCategory"
                        @bind:after="RefreshProductListAsync">

                    <option value="all">Alle kategorier</option>
                    <option value="keyboard">Tastaturer</option>
                    <option value="mouse">Mus</option>
                    <option value="mousepad">Musemåtter</option>
                    <option value="keycap">Keycaps</option>

                </select>

            </div>

            <div class="col-md-6">

                <label class="form-label">Sortér efter</label>

                <select class="form-select"
                        @bind="SelectedSort"
                        @bind:after="RefreshProductListAsync">

                    <option value="default">Standard</option>
                    <option value="name">Navn: A–Å</option>
                    <option value="priceAsc">Pris: Laveste først</option>
                    <option value="priceDesc">Pris: Højeste først</option>

                </select>

            </div>

        </div>

    </div>



    <div class="employee-form-section mt-4">
        <h3>@(HasActiveSearch ? "Søgeresultater" : "Alle produkter")</h3>

        @if (!string.IsNullOrEmpty(ProductLoadError))
        {
            <p class="text-danger mt-3" role="alert">@ProductLoadError</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Produktnavn</th>
                            <th>Kategori</th>
                            <th>Pris</th>
                            <th>Lager</th>
                            <th>Handlinger</th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize TItem="Product"
                                    ItemsProvider="LoadProductPageAsync"
                                    Context="product"
                                    @ref="ProductVirtualize"
                                    MaxItemCount="30"
                                    SpacerElement="tr">
                            <ItemContent>
                                <tr>
                                    <td>@product.ID</td>
                                    <td>@product.Name</td>
                                    <td>@GetCategoryDisplayName(product)</td>
                                    <td>@product.Price.ToString("N2") kr.</td>
                                    <td>@product.Stock</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button"
                                                    class="page-button-outline"
                                                    title="Rediger produkt"
                                                    @onclick="() => OpenEditPopup(product)">
                                                ✏️
                                            </button>
                                            <button type="button"
                                                    class="page-button-outline"
                                                    title="Slet produkt"
                                                    @onclick="() => OpenDeletePopup(product)">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </ItemContent>
                            <Placeholder>
                                <tr><td colspan="6">Indlæser produkter...</td></tr>
                            </Placeholder>
                            <EmptyContent>
                                <tr>
                                    <td colspan="6">
                                        @(HasActiveSearch
                                            ? "Ingen produkter matcher din søgning."
                                            : "Der er ingen produkter i databasen.")
                                    </td>
                                </tr>
                            </EmptyContent>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>



@if (ShowCreatePopup)
{
    <div class="profile-modal-overlay">

        <div class="profile-modal">

            <h3>Tilføj produkt</h3>

            <hr />

            <div class="row g-3">

                <div class="col-md-12">
                    <label class="form-label">Kategori</label>

                    <select class="form-select"
                            value="@NewProductCategory"
                            @onchange="OnCreateCategoryChanged">
                        <option value="">Vælg kategori</option>
                        @foreach (var category in ProductNameHelper.SubClassesUserName.Values)
                        {
                            <option value="@category.Category">@category.CategoryUserView</option>
                        }
                    </select>
                </div>
                @foreach (CachedProperty property in CreateProductProperties)
                {
                    var propertyType = Nullable.GetUnderlyingType(property.Property.PropertyType)
                        ?? property.Property.PropertyType;

                    <div class="col-md-6">
                        <label class="form-label" for="@($"create-{property.Property.Name}")">
                            @(property.UserPageName ?? property.Property.Name)
                        </label>

                        @if (propertyType == typeof(bool))
                        {
                            <select id="@($"create-{property.Property.Name}")"
                                    class="form-select"
                                    value="@GetCreatePropertyValue(property.Property)"
                                    @onchange="e => SetCreatePropertyValue(property.Property, e.Value?.ToString())">
                                <option value="">Vælg</option>
                                <option value="true">Ja</option>
                                <option value="false">Nej</option>
                            </select>
                        }
                        else if (propertyType == typeof(string) &&
                                 property.Property.Name == nameof(Product.Description))
                        {
                            <textarea id="@($"create-{property.Property.Name}")"
                                      class="form-control"
                                      rows="3"
                                      value="@GetCreatePropertyValue(property.Property)"
                                      @oninput="e => SetCreatePropertyValue(property.Property, e.Value?.ToString())">
                            </textarea>
                        }
                        else
                        {
                            <input id="@($"create-{property.Property.Name}")"
                                   type="@GetCreateInputType(propertyType)"
                                   step="@(propertyType == typeof(decimal) ? "0.01" : null)"
                                   min="@(propertyType == typeof(int) || propertyType == typeof(decimal) ? "0" : null)"
                                   class="form-control"
                                   value="@GetCreatePropertyValue(property.Property)"
                                   @oninput="e => SetCreatePropertyValue(property.Property, e.Value?.ToString())" />
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(CreateError))
            {
                <p class="text-danger mt-3">@CreateError</p>
            }

            <div class="profile-modal-actions">

                <button type="button"
                        class="page-button-outline"
                        @onclick="CloseCreatePopup">
                    Annuller
                </button>

                <button type="button"
                        class="page-button"
                        disabled="@(string.IsNullOrEmpty(NewProductCategory))"
                        @onclick="CreateProductAsync">
                    Opret produkt
                </button>

            </div>

        </div>

    </div>
}


@code {


    private string SearchText = "";
    private string SelectedCategory = "all";
    private string SelectedSort = "default";
    private string? ProductLoadError;
    private Virtualize<Product>? ProductVirtualize;

    private bool HasActiveSearch =>
        !string.IsNullOrWhiteSpace(SearchText) ||
        SelectedCategory != "all";



    private bool ShowCreatePopup = false;
    private string CreateError = "";
    private string CreateSuccess = "";
    private string NewProductCategory = "";
    private readonly Dictionary<string, string> CreatePropertyValues = [];

    private IEnumerable<CachedProperty> CreateProductProperties
    {
        get
        {
            Type? productType = GetSelectedProductType();
            if (productType is null)
            {
                return [];
            }

            return PropertyNameHelper.GetPropertiesWithMetaData(productType)
                .Where(property =>
                    property.Property.Name != nameof(Product.ID) &&
                    property.Property.SetMethod?.IsPublic == true &&
                    IsSupportedCreatePropertyType(property.Property.PropertyType));
        }
    }

    private Type? GetSelectedProductType()
    {
        return ProductNameHelper.SubClassesUserName
            .FirstOrDefault(category => category.Value.Category == NewProductCategory)
            .Key;
    }



    private async ValueTask<ItemsProviderResult<Product>> LoadProductPageAsync(
        ItemsProviderRequest request)
    {
        try
        {
            (List<Product> products, int totalCount) = await ProductService.GetProductPageAsync(
                request.StartIndex,
                Math.Min(request.Count, 30),
                SelectedCategory == "all" ? null : SelectedCategory,
                SearchText,
                SelectedSort,
                request.CancellationToken);
            ProductLoadError = null;
            return new ItemsProviderResult<Product>(products, totalCount);
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception) when (exception is DbException or InvalidOperationException)
        {
            Logger.LogError(exception, "Could not load a product page for product administration.");
            ProductLoadError = "Produkter kunne ikke indlæses. Prøv at ændre søgningen eller genindlæse siden.";
            await InvokeAsync(StateHasChanged);
            return new ItemsProviderResult<Product>([], 0);
        }
    }

    private async Task RefreshProductListAsync()
    {
        ProductLoadError = null;
        if (ProductVirtualize is not null)
        {
            await ProductVirtualize.RefreshDataAsync();
        }
    }

    private static string GetCategoryDisplayName(Product product)
    {
        string? categoryName = ProductNameHelper.SubClassesUserName
            .FirstOrDefault(entry => entry.Value.Category == ProductFactory.GetCategory(product))
            .Value.CategoryUserView;

        return categoryName ?? ProductFactory.GetCategory(product);
    }

    private void OpenCreatePopup()
    {
        NewProductCategory = "";
        CreatePropertyValues.Clear();
        CreateError = "";
        CreateSuccess = "";
        ShowCreatePopup = true;
    }

    private void OnCreateCategoryChanged(ChangeEventArgs args)
    {
        NewProductCategory = args.Value?.ToString() ?? "";
        CreateError = "";
        CreatePropertyValues.Clear();

        Type? productType = GetSelectedProductType();
        if (productType is null)
        {
            return;
        }

        var product = (Product?)Activator.CreateInstance(productType);
        if (product is null)
        {
            CreateError = "Produktkategorien kunne ikke indlæses.";
            return;
        }

        foreach (CachedProperty property in CreateProductProperties)
        {
            object? value = property.Property.GetValue(product);
            CreatePropertyValues[property.Property.Name] = value switch
            {
                null => "",
                bool boolean => boolean ? "true" : "false",
                IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
                _ => value.ToString() ?? ""
            };
        }
    }

    private string GetCreatePropertyValue(PropertyInfo property)
    {
        return CreatePropertyValues.GetValueOrDefault(property.Name, "");
    }

    private void SetCreatePropertyValue(PropertyInfo property, string? value)
    {
        CreatePropertyValues[property.Name] = value ?? "";
        CreateError = "";
    }

    private static bool IsSupportedCreatePropertyType(Type type)
    {
        type = Nullable.GetUnderlyingType(type) ?? type;
        return type == typeof(string) ||
               type == typeof(bool) ||
               type == typeof(int) ||
               type == typeof(decimal);
    }

    private static string GetCreateInputType(Type type)
    {
        type = Nullable.GetUnderlyingType(type) ?? type;
        return type == typeof(int) || type == typeof(decimal) ? "number" : "text";
    }



    private void CloseCreatePopup()
    {
        ShowCreatePopup = false;
        CreateError = "";
    }



    private async Task CreateProductAsync()
    {
        CreateError = "";

        Type? productType = GetSelectedProductType();
        if (productType is null)
        {
            CreateError = "Vælg en produktkategori.";
            return;
        }

        if (Activator.CreateInstance(productType) is not Product product)
        {
            CreateError = "Produktkategorien kunne ikke oprettes.";
            return;
        }

        foreach (CachedProperty property in CreateProductProperties)
        {
            string value = GetCreatePropertyValue(property.Property);
            Type propertyType = Nullable.GetUnderlyingType(property.Property.PropertyType)
                ?? property.Property.PropertyType;

            try
            {
                if (propertyType == typeof(string) && string.IsNullOrWhiteSpace(value))
                {
                    CreateError = $"{property.UserPageName ?? property.Property.Name} skal udfyldes.";
                    return;
                }

                object? convertedValue = propertyType == typeof(string)
                    ? value.Trim()
                    : propertyType == typeof(bool)
                        ? bool.Parse(value)
                        : Convert.ChangeType(value, propertyType, CultureInfo.InvariantCulture);

                property.Property.SetValue(product, convertedValue);
            }
            catch (Exception exception) when (
                exception is FormatException or OverflowException or ArgumentException or
                TargetInvocationException)
            {
                CreateError = $"{property.UserPageName ?? property.Property.Name}: " +
                    (exception is TargetInvocationException { InnerException: not null } invocationException
                        ? invocationException.InnerException?.Message ?? exception.Message
                        : exception.Message);
                return;
            }
        }

        try
        {
            await ProductService.CreateProductAsync(product);
            SearchText = product.Name;
            SelectedCategory = "all";
            await RefreshProductListAsync();
            CreateSuccess = $"Produktet {product.Name} blev oprettet.";
            CloseCreatePopup();
        }
        catch (DbException exception)
        {
            Logger.LogError(exception, "Could not create product in category {Category}.", NewProductCategory);
            CreateError = "Produktet kunne ikke gemmes. Kontrollér oplysningerne, og prøv igen.";
        }
    }


    private void OpenEditPopup(Product product)
    {
    }

    private void OpenDeletePopup(Product product)
    {
    }
}