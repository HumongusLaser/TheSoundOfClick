@page "/reset-password"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

    <AuthCard Title="Nulstil adgangskode"
              Description="Vælg en ny adgangskode til din konto">

        <div class="auth-form">

            <div class="auth-field">
                <label for="newPassword">Ny adgangskode</label>

                <div class="auth-password-requirements">
                    <p>Din adgangskode skal indeholde:</p>

                    <ul>
                        <li>Mindst 16 tegn</li>
                        <li>Mindst 2 store bogstaver</li>
                        <li>Mindst 2 tal</li>
                        <li>Mindst 2 specialtegn</li>
                    </ul>
                </div>

                <input id="newPassword"
                       type="password"
                       placeholder="Indtast din nye adgangskode"
                       autocomplete="new-password"
                       @bind="NewPassword" />
            </div>

            <div class="auth-field">
                <label for="confirmNewPassword">Gentag ny adgangskode</label>

                <input id="confirmNewPassword"
                       type="password"
                       placeholder="Gentag din nye adgangskode"
                       autocomplete="new-password"
                       @bind="ConfirmNewPassword" />
            </div>

            <button type="button"
                    class="auth-button"
                    @onclick="ResetUserPassword">
                Nulstil adgangskode
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="auth-message" role="status">
                    @Message
                </p>
            }

            <div class="auth-footer">
                <p>
                    Kan du huske din adgangskode?
                    <a href="/login">Tilbage til login</a>
                </p>
            </div>

        </div>

    </AuthCard>

</div>
@code {
    private string NewPassword = "";
    private string ConfirmNewPassword = "";
    private string Message = "";

    private ValidationService validationService = new ValidationService();

    private void ResetUserPassword()
    {
        Message = "";

        if (string.IsNullOrWhiteSpace(NewPassword) ||
            string.IsNullOrWhiteSpace(ConfirmNewPassword))
        {
            Message = "Du skal udfylde begge felter.";
            return;
        }

        if (!validationService.IsValidPassword(NewPassword))
        {
            Message = "Dit password overholder ikke kravene.";
            return;
        }

        if (NewPassword != ConfirmNewPassword)
        {
            Message = "De to passwords er ikke ens.";
            return;
        }

        Message = "Passwordet overholder kravene, men er ikke nulstillet endnu.";
    }
}