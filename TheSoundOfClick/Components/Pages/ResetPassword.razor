

@page "/reset-password"
@rendermode InteractiveServer

<h3>Nulstil password</h3>

<p>Her kan du vælge et nyt password til din konto.</p>

<div class="mb-3">
    <label class="form-label">Nyt password</label>

    <p class="text-muted small mb-2">
        Vælg et unikt password, som du ikke bruger andre steder.
        <br />
        Dit password skal indeholde:
        <br />
        • Mindst 16 tegn
        <br />
        • Mindst 2 store bogstaver
        <br />
        • Mindst 2 tal
        <br />
        • Mindst 2 specialtegn (fx !, # eller ?)
    </p>

    <input type="password" class="form-control" @bind="NewPassword" />
</div>

<div class="mb-3">
    <label class="form-label">Gentag nyt password</label>
    <input type="password" class="form-control" @bind="ConfirmNewPassword" />
</div>

<button class="btn btn-primary" @onclick="ResetUserPassword">
    Nulstil password
</button>

@if (!string.IsNullOrEmpty(Message))
{
    <p class="mt-3">@Message</p>
}

@code {
    private string NewPassword = "";
    private string ConfirmNewPassword = "";
    private string Message = "";

    private ValidationService validationService = new ValidationService();

    private void ResetUserPassword()
    {
        Message = "";

        if (string.IsNullOrWhiteSpace(NewPassword) ||
            string.IsNullOrWhiteSpace(ConfirmNewPassword))
        {
            Message = "Du skal udfylde begge felter.";
            return;
        }

        if (!validationService.IsValidPassword(NewPassword))
        {
            Message = "Dit password overholder ikke kravene.";
            return;
        }

        if (NewPassword != ConfirmNewPassword)
        {
            Message = "De to passwords er ikke ens.";
            return;
        }

        Message = "Passwordet overholder kravene, men er ikke nulstillet endnu.";
    }
}