@page "/reset-password"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents
@inject NavigationManager Navigation
@inject PasswordResetService PasswordResetService
@inject ILogger<ResetPassword> Logger

<div class="auth-page">

    <AuthCard Title="Nulstil adgangskode"
              Description="Vælg en ny adgangskode til din konto">

        <div class="auth-form">

            @if (IsCompleted)
            {
                <p class="auth-message" role="status">
                    Din adgangskode er nulstillet. Du kan nu logge ind med din nye adgangskode.
                </p>
                <div class="auth-footer">
                    <a href="/login">Gå til login</a>
                </div>
            }
            else
            {
            @if (!string.IsNullOrEmpty(TokenError))
            {
                <p class="auth-message" role="alert">@TokenError</p>
            }

            <div class="auth-field">
                <label for="newPassword">Ny adgangskode</label>

                <div class="auth-password-requirements">
                    <p>Din adgangskode skal indeholde:</p>

                    <ul>
                        <li>Mindst 16 tegn</li>
                        <li>Mindst 2 store bogstaver</li>
                        <li>Mindst 2 tal</li>
                        <li>Mindst 2 specialtegn</li>
                    </ul>
                </div>

                <input id="newPassword"
                       type="password"
                       placeholder="Indtast din nye adgangskode"
                       autocomplete="new-password"
                       disabled="@(IsSaving || string.IsNullOrEmpty(ResetToken))"
                       @bind="NewPassword" />
            </div>

            <div class="auth-field">
                <label for="confirmNewPassword">Gentag ny adgangskode</label>

                <input id="confirmNewPassword"
                       type="password"
                       placeholder="Gentag din nye adgangskode"
                       autocomplete="new-password"
                       disabled="@(IsSaving || string.IsNullOrEmpty(ResetToken))"
                       @bind="ConfirmNewPassword" />
            </div>

            <button type="button"
                    class="auth-button"
                    disabled="@(IsSaving || string.IsNullOrEmpty(ResetToken))"
                    @onclick="ResetUserPasswordAsync">
                @(IsSaving ? "Gemmer..." : "Nulstil adgangskode")
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="auth-message" role="alert">
                    @Message
                </p>
            }

            <div class="auth-footer">
                <p>
                    Kan du huske din adgangskode?
                    <a href="/login">Tilbage til login</a>
                </p>
            </div>
            }
        </div>

    </AuthCard>

</div>
@code {
    private string NewPassword = "";
    private string ConfirmNewPassword = "";
    private string Message = "";
    private string? ResetToken;
    private string? TokenError;
    private bool IsSaving;
    private bool IsCompleted;

    protected override void OnInitialized()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        ResetToken = query.TryGetValue("token", out var token) ? token.ToString() : null;
        if (string.IsNullOrWhiteSpace(ResetToken))
        {
            TokenError = "Nulstillingslinket mangler eller er ugyldigt. Bed om et nyt link.";
        }
    }

    private async Task ResetUserPasswordAsync()
    {
        Message = "";
        if (string.IsNullOrWhiteSpace(ResetToken))
        {
            TokenError = "Nulstillingslinket mangler eller er ugyldigt. Bed om et nyt link.";
            return;
        }

        IsSaving = true;
        try
        {
            await PasswordResetService.ResetPasswordAsync(ResetToken, NewPassword, ConfirmNewPassword);
            NewPassword = "";
            ConfirmNewPassword = "";
            IsCompleted = true;
        }
        catch (InvalidOperationException exception)
        {
            Message = exception.Message;
        }
        catch (Exception exception) when (exception is System.Data.Common.DbException or FormatException)
        {
            Logger.LogError(exception, "Password reset failed.");
            Message = "Adgangskoden kunne ikke nulstilles lige nu. Prøv igen senere.";
        }
        finally
        {
            IsSaving = false;
        }
    }
}