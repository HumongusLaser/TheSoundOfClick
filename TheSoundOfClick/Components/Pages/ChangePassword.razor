@page "/change-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Data.Common
@attribute [Authorize]
@inject UserService UserService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ChangePassword> Logger

<PageTitle>Skift adgangskode | The Sound Of Click</PageTitle>

<main class="change-password-page">
    <NavLink class="change-password-back" href="/profile">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        Tilbage til min profil
    </NavLink>

    <section class="change-password-card" aria-labelledby="change-password-title">
        <div class="change-password-icon" aria-hidden="true">
            <i class="bi bi-shield-lock"></i>
        </div>

        <p class="change-password-eyebrow">KONTO OG SIKKERHED</p>
        <h1 id="change-password-title">Skift adgangskode</h1>
        <p class="change-password-intro">
            Vælg en ny, unik adgangskode. Du skal bekræfte din nuværende adgangskode for at fortsætte.
        </p>

        <div class="change-password-fields">
            <div class="change-password-field">
                <label for="current-password">Nuværende adgangskode</label>
                <input id="current-password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       @bind="CurrentPassword"
                       disabled="@IsSaving" />
            </div>

            <div class="change-password-field">
                <label for="new-password">Ny adgangskode</label>
                <input id="new-password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       @bind="NewPassword"
                       disabled="@IsSaving" />
            </div>

            <div class="change-password-field">
                <label for="confirm-password">Gentag ny adgangskode</label>
                <input id="confirm-password"
                       type="password"
                       class="form-control"
                       autocomplete="new-password"
                       @bind="ConfirmNewPassword"
                       disabled="@IsSaving" />
            </div>
        </div>

        <aside class="change-password-requirements">
            <h2><i class="bi bi-check2-circle" aria-hidden="true"></i> Krav til adgangskoden</h2>
            <ul>
                <li>Mindst 16 tegn</li>
                <li>Mindst 2 store bogstaver</li>
                <li>Mindst 2 tal</li>
                <li>Mindst 2 specialtegn</li>
            </ul>
        </aside>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="change-password-message change-password-error" role="alert">
                <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                @ErrorMessage
            </p>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <p class="change-password-message change-password-success" role="status">
                <i class="bi bi-check-circle" aria-hidden="true"></i>
                @SuccessMessage
            </p>
        }

        <button type="button"
                class="change-password-submit"
                disabled="@IsSaving"
                @onclick="ChangeUserPasswordAsync">
            @if (IsSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Gemmer adgangskode...</span>
            }
            else
            {
                <i class="bi bi-lock-fill me-2" aria-hidden="true"></i>
                <span>Gem ny adgangskode</span>
            }
        </button>

        <p class="change-password-security-note">
            <i class="bi bi-shield-check" aria-hidden="true"></i>
            Din adgangskode gemmes sikkert og kan ikke læses af andre.
        </p>
    </section>
</main>

@code {
    private string CurrentPassword = "";
    private string NewPassword = "";
    private string ConfirmNewPassword = "";
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsSaving;

    private async Task ChangeUserPasswordAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrWhiteSpace(CurrentPassword) ||
            string.IsNullOrWhiteSpace(NewPassword) ||
            string.IsNullOrWhiteSpace(ConfirmNewPassword))
        {
            ErrorMessage = "Udfyld alle felter.";
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(
                authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
                out Guid userId))
        {
            ErrorMessage = "Din session kunne ikke bekræftes. Log ind igen.";
            return;
        }

        IsSaving = true;
        try
        {
            await UserService.ChangePasswordAsync(
                userId,
                CurrentPassword,
                NewPassword,
                ConfirmNewPassword);

            CurrentPassword = "";
            NewPassword = "";
            ConfirmNewPassword = "";
            SuccessMessage = "Din adgangskode er blevet ændret.";
        }
        catch (InvalidOperationException exception)
        {
            ErrorMessage = exception.Message;
        }
        catch (NotFoundException exception)
        {
            Logger.LogWarning(exception, "Could not change password for user {UserId}.", userId);
            ErrorMessage = "Din konto blev ikke fundet. Log ind igen.";
        }
        catch (Exception exception) when (exception is DbException or FormatException)
        {
            Logger.LogError(exception, "Could not change password for user {UserId}.", userId);
            ErrorMessage = "Adgangskoden kunne ikke ændres lige nu. Prøv igen.";
        }
        finally
        {
            IsSaving = false;
        }
    }
}
