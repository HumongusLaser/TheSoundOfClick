@using TheSoundOfClick

@page "/change-password"
@rendermode InteractiveServer

<h3>Ændre adgangskode</h3>

<p>Her kan du ændre din adgangskode.</p>

<div class="mb-3">
    <label class="form-label">Nuværende password</label>
    <input type="password" class="form-control" @bind="CurrentPassword" />
</div>

<div class="mb-3">
    <label class="form-label">Nyt password</label>

    <p class="text-muted small mb-2">
        Vælg et unikt password, som du ikke bruger andre steder.
        <br />
        Dit password skal indeholde:
        <br />
        • Mindst 16 tegn
        <br />
        • Mindst 2 store bogstaver
        <br />
        • Mindst 2 tal
        <br />
        • Mindst 2 specialtegn (fx !, # eller ?)
    </p>

    <input type="password" class="form-control" @bind="NewPassword" />
</div>

<div class="mb-3">
    <label class="form-label">Gentag nyt password</label>
    <input type="password" class="form-control" @bind="ConfirmNewPassword" />
</div>

<button class="btn btn-primary" @onclick="ChangeUserPassword">
    Ændre password
</button>

@if (!string.IsNullOrEmpty(Message))
{
    <p class="mt-3">@Message</p>
}
@code {
    private string CurrentPassword = "";
    private string NewPassword = "";
    private string ConfirmNewPassword = "";
    private string Message = "";

    private ValidationService validationService = new ValidationService();

    private void ChangeUserPassword()
    {
        Message = "";

        if (string.IsNullOrWhiteSpace(CurrentPassword) ||
            string.IsNullOrWhiteSpace(NewPassword) ||
            string.IsNullOrWhiteSpace(ConfirmNewPassword))
        {
            Message = "Du skal udfylde alle felterne.";
            return;
        }

        if (!validationService.IsValidPassword(NewPassword))
        {
            Message = "Dit nye password overholder ikke kravene.";
            return;
        }

        if (NewPassword != ConfirmNewPassword)
        {
            Message = "De to nye passwords er ikke ens.";
            return;
        }

        if (CurrentPassword == NewPassword)
        {
            Message = "Dit nye password skal være anderledes end dit nuværende.";
            return;
        }

        Message = "Oplysningerne er godkendt. Passwordet er ikke ændret endnu.";
    }
}