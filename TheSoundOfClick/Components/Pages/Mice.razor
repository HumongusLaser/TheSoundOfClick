@page "/mice"
@rendermode InteractiveServer

<PageTitle>Mus | The Sound Of Click</PageTitle>

<div class="page-content">

    <h1>Mus</h1>

    <p class="page-description">
        Find den perfekte gamingmus til dit setup.
    </p>

    <hr />
    <div class="row g-3 mb-4 mt-4">

        <div class="col-md-4">

            <label class="form-label">Forbindelse</label>

            <select class="form-select" @bind="SelectedConnection">
                <option value="all">Alle</option>
                <option value="wireless">Trådløs</option>
                <option value="wired">Med kabel</option>
            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">Type</label>

            <select class="form-select" @bind="SelectedType">
                <option value="all">Alle typer</option>
                <option value="Gaming">Gaming</option>
                <option value="Ergonomisk">Ergonomisk</option>
                <option value="Standard">Standard</option>
            </select>

        </div>

        <div class="col-md-4">

            <label class="form-label">Sortér efter</label>

            <select class="form-select" @bind="SelectedSort">
                <option value="default">Standard</option>
                <option value="price-asc">Pris: Laveste først</option>
                <option value="price-desc">Pris: Højeste først</option>
                <option value="name">Navn: A–Å</option>
            </select>

        </div>

    </div>
    <div class="row g-4 mt-3">

        @if (FilteredMice.Any())
        {
            @foreach (var mouse in FilteredMice)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="product-card">

                        <div class="product-image">

                            <img src="@mouse.Image"
                                 alt="@mouse.Name" />

                        </div>
                        <div class="product-info">

                            <h3>@mouse.Name</h3>

                            <p>@mouse.Description</p>

                            <div class="product-price">
                                @mouse.Price.ToString("N2") kr.
                            </div>

                            <div class="product-actions">

                                <button type="button"
                                        class="page-button-outline">
                                    Se produkt
                                </button>

                                <button type="button"
                                        class="page-button">
                                    Læg i kurv
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="employee-form-section text-center">

                    <h3>Ingen produkter fundet</h3>

                    <p class="page-description">
                        Der er desværre ingen mus, der matcher dine valgte filtre.
                    </p>

                    <button type="button"
                            class="page-button-outline mt-3"
                            @onclick="ResetFilters">
                        Nulstil filtre
                    </button>

                </div>

            </div>
        }

    </div>

</div>

@code {

    private string SelectedConnection = "all";
    private string SelectedType = "all";
    private string SelectedSort = "default";


    private List<MouseProduct> Miceee = new()
    {
        new MouseProduct
        {
            Name = "RGB Gaming Mouse",
            Description = "Gamingmus med RGB-belysning og justerbar DPI.",
            Price = 399,
            Image = "/images/mice/mouse1.jpg",
            IsWireless = false,
            Type = "Gaming"
        },

        new MouseProduct
        {
            Name = "Wireless Gaming Mouse",
            Description = "Trådløs gamingmus med høj præcision og lang batteritid.",
            Price = 649,
            Image = "/images/mice/mouse2.jpg",
            IsWireless = true,
            Type = "Gaming"
        },

        new MouseProduct
        {
            Name = "Lightweight Gaming Mouse",
            Description = "Let gamingmus designet til hurtige bevægelser.",
            Price = 499,
            Image = "/images/mice/mouse3.jpg",
            IsWireless = false,
            Type = "Gaming"
        }
    };


    private IEnumerable<MouseProduct> SortedMice =>
        SelectedSort switch
        {
            "price-asc" => Miceee.OrderBy(m => m.Price),

            "price-desc" => Miceee.OrderByDescending(m => m.Price),

            "name" => Miceee.OrderBy(m => m.Name),

            _ => Miceee
        };


    private IEnumerable<MouseProduct> FilteredMice
    {
        get
        {
            var mice = SortedMice;

            if (SelectedConnection == "wireless")
            {
                mice = mice.Where(m => m.IsWireless);
            }
            else if (SelectedConnection == "wired")
            {
                mice = mice.Where(m => !m.IsWireless);
            }

            if (SelectedType != "all")
            {
                mice = mice.Where(m => m.Type == SelectedType);
            }

            return mice;
        }
    }


    private void ResetFilters()
    {
        SelectedConnection = "all";
        SelectedType = "all";
        SelectedSort = "default";
    }


    private class MouseProduct
    {
        public string Name { get; set; } = "";

        public string Description { get; set; } = "";

        public decimal Price { get; set; }

        public string Image { get; set; } = "";

        public bool IsWireless { get; set; }

        public string Type { get; set; } = "";
    }
}