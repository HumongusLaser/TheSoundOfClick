@page "/Error"
@using System.Diagnostics

<PageTitle>System meltdown | The Sound Of Click</PageTitle>

<main class="error-page" role="alert">
    <div class="error-skyline" aria-hidden="true">
        <div class="error-blast error-blast-left">
            <span class="blast-core"></span>
            <span class="blast-ring"></span>
            <span class="blast-rays"></span>
            <span class="blast-sparks"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="error-blast error-blast-right">
            <span class="blast-core"></span>
            <span class="blast-ring"></span>
            <span class="blast-rays"></span>
            <span class="blast-sparks"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="error-blast error-blast-bottom">
            <span class="blast-core"></span>
            <span class="blast-ring"></span>
            <span class="blast-rays"></span>
            <span class="blast-sparks"><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </div>
    </div>

    <section class="error-panel">
        <div class="error-emblem" aria-hidden="true">
            <span class="error-emblem-ring"></span>
            <span class="error-emblem-flash">!</span>
        </div>

        <p class="error-kicker">SYSTEM MELTDOWN</p>
        <h1>Well, that <span>blew up.</span></h1>
        <p class="error-copy">
            Something went wrong while loading this page. The good news: your browser is still in one piece.
        </p>

        @if (ShowRequestId)
        {
            <div class="error-request">
                <span>Incident ID</span>
                <code>@RequestId</code>
            </div>
        }

        <a class="error-home-button" href="/">
            <i class="bi bi-house-fill" aria-hidden="true"></i>
            Back to safety
        </a>

        <details class="error-debug-note">
            <summary>Local developer note</summary>
            <p>
                Detailed exception information is intentionally hidden from visitors. For local debugging,
                use the Development environment. Never enable it on a deployed application.
            </p>
        </details>
    </section>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
