@page "/forgot-password"
@rendermode InteractiveServer
@using TheSoundOfClick
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

    <AuthCard Title="Glemt adgangskode?"
              Description="Bare rolig! Vi hjælper dig med at få adgang til din konto igen.">

        <div class="auth-form">

           
            <div class="auth-field">

                <label for="email">Emailadresse</label>

                <input id="email"
                       type="email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       @bind="Email" />

            </div>

            <p class="auth-info">
                Indtast den emailadresse, du brugte til at oprette din konto.
                Hvis adressen findes i vores system, sender vi dig et link
                til at nulstille din adgangskode.
            </p>

            <button type="button"
                    class="auth-button"
                    @onclick="SendResetLink">
                Send nulstillingslink
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="auth-message" role="status">
                    @Message
                </p>
            }

            <div class="auth-footer">
                <p>
                    Kan du huske din adgangskode?
                    <a href="/login">Tilbage til login</a>
                </p>
            </div>

        </div>

    </AuthCard>

</div>

@code {
    private string Email = "";
    private string Message = "";

    private ValidationService validationService = new ValidationService();

    private void SendResetLink()
    {
        Message = "";

        if (!validationService.IsValidEmail(Email))
        {
            Message = "Du skal indtaste en gyldig emailadresse.";
            return;
        }

        Message = "Hvis emailadressen findes i vores system, vil du modtage et link til at nulstille dit password :)";
    }
}