@page "/forgot-password"
@rendermode InteractiveServer
@using TheSoundOfClick
@using TheSoundOfClick.Components.AuthComponents
@inject PasswordResetService PasswordResetService
@inject ILogger<ForgotPassword> Logger
@inject ValidationService ValidationService

<div class="auth-page">

    <AuthCard Title="Glemt adgangskode?"
              Description="Bare rolig! Vi hjælper dig med at få adgang til din konto igen.">

        <div class="auth-form">

           
            <div class="auth-field">

                <label for="email">Emailadresse</label>

                <input id="email"
                       type="email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       @bind="Email" />

            </div>

            <p class="auth-info">
                Indtast den emailadresse, du brugte til at oprette din konto.
                Hvis adressen findes i vores system, sender vi dig et link
                til at nulstille din adgangskode.
            </p>

            <button type="button"
                    class="auth-button"
                    disabled="@IsSending"
                    @onclick="SendResetLinkAsync">
                @(IsSending ? "Sender..." : "Send nulstillingslink")
            </button>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="auth-message" role="alert">
                    @ErrorMessage
                </p>
            }

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <p class="auth-message" role="status">
                    @SuccessMessage
                </p>
            }

            <div class="auth-footer">
                <p>
                    Kan du huske din adgangskode?
                    <a href="/login">Tilbage til login</a>
                </p>
            </div>

        </div>

    </AuthCard>

</div>

@code {
    private string Email = "";
    private string? ErrorMessage;
    private string? SuccessMessage;
    private bool IsSending;

    private async Task SendResetLinkAsync()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (!ValidationService.IsValidEmail(Email))
        {
            ErrorMessage = "Du skal indtaste en gyldig e-mailadresse.";
            return;
        }

        IsSending = true;
        try
        {
            await PasswordResetService.RequestResetAsync(Email);
        }
        catch (Exception exception)
        {
            // Keep the response identical for known and unknown addresses to prevent account enumeration.
            Logger.LogError(exception, "Password reset request failed.");
        }
        finally
        {
            SuccessMessage = "Hvis e-mailadressen findes i systemet, og e-mail kan leveres, sender vi et nulstillingslink.";
            IsSending = false;
        }
    }
}