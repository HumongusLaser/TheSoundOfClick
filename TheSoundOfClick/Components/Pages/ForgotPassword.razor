@using TheSoundOfClick

@page "/forgot-password"
@rendermode InteractiveServer

<h3>Glemt password</h3>

<p>
    Har du glemt dit password?
    Indtast din emailadresse, så sender vi dig et link til at oprette et nyt.
</p>

<div class="mb-3">
    <label class="form-label">Emailadresse</label>
    <input type="email" class="form-control" @bind="Email" />
</div>

<button class="btn btn-primary" @onclick="SendResetLink">
    Send link
</button>

@if (!string.IsNullOrEmpty(Message))
{
    <p class="mt-3">@Message</p>
}

@code {
    private string Email = "";
    private string Message = "";

    private ValidationService validationService = new ValidationService();

    private void SendResetLink()
    {
        Message = "";

        if (!validationService.IsValidEmail(Email))
        {
            Message = "Du skal indtaste en gyldig emailadresse.";
            return;
        }

        Message = "Hvis emailadressen findes i vores system, vil du modtage et link til at nulstille dit password :)";
    }
}