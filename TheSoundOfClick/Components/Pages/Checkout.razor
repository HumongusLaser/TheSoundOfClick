@page "/checkout"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject CartService CartService

<PageTitle>Køb gennemført | The Sound Of Click</PageTitle>

<div class="page-content">
    <h1>Køb gennemført</h1>

    @if (CartService.LastCheckoutOrder is not Order order)
    {
        <div class="employee-form-section">
            <p class="page-description">
                Der er ingen kvittering at vise. Gå til kurven for at gennemføre et køb.
            </p>
            <a class="page-button" href="/cart">Til kurven</a>
        </div>
    }
    else
    {
        <div class="employee-form-section">
            <p class="page-description" role="status">
                Tak for dit køb. Lagerbeholdningen er opdateret, og varerne er fjernet fra din kurv.
            </p>
            <p>Ordrenummer: @order.ID</p>
            <p>Dato: @order.DateCreated.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</p>
            <p>Leveringsadresse: @order.ShippingAddress</p>

            <div class="table-responsive">
                <table class="table admin-table">
                    <thead>
                        <tr>
                            <th>Produkt</th>
                            <th>Pris</th>
                            <th>Antal</th>
                            <th>I alt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach ((Product product, int quantity) in order.OrderList)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Price.ToString("N2") kr.</td>
                                <td>@quantity</td>
                                <td>@((product.Price * quantity).ToString("N2")) kr.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Total</th>
                            <th>@order.TotalPrice.ToString("N2") kr.</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <a class="page-button mt-3" href="/keyboards">Fortsæt med at handle</a>
        </div>
    }
</div>
