@page "/product/{Id}"
@using System.Reflection
@rendermode InteractiveServer
@inject ProductService ProductService
@inject CartService CartService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Produktdetaljer | The Sound Of Click</PageTitle>

<div class="page-content">

    @if (product != null)
    {
        <div class="product-details-container">

            <!-- Tilbageknap -->
            <button type="button"
                    class="page-button-outline mb-4"
                    @onclick="GoBack">
                ← Tilbage
            </button>

            <div class="row g-5">

                <!-- VENSTRE SIDE: PRODUKTBILLEDE -->
                <div class="col-12 col-lg-6">

                    <div class="product-details-image">

                        <div class="product-image-placeholder">
                            <i class="bi bi-image"></i>
                            <p>Produktbillede kommer snart</p>
                        </div>

                    </div>

                </div>

                <!-- HØJRE SIDE: PRODUKTINFORMATION -->
                <div class="col-12 col-lg-6">

                    <div class="product-details-info">

                        <h1>@product.Name</h1>

                        <p class="product-details-description">
                            @product.Description
                        </p>

                        <div class="product-details-price">
                            @product.Price.ToString("N2") kr.
                        </div>

                        <!-- Lagerstatus -->
                        <div class="product-stock-status">

                            @if (product.Stock > 0)
                            {
                                <span class="in-stock">
                                    <i class="bi bi-check-circle-fill"></i>
                                    På lager (@product.Stock stk.)
                                </span>
                            }
                            else
                            {
                                <span class="out-of-stock">
                                    <i class="bi bi-x-circle-fill"></i>
                                    Ikke på lager
                                </span>
                            }

                        </div>

                        <hr class="my-4" />

                        <!-- Antal -->
                        <div class="product-quantity-section">

                            <label class="form-label">
                                Antal
                            </label>

                            <div class="input-group" style="max-width: 12rem;">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        aria-label="Reducer antal"
                                        disabled="@(product.Stock <= 0 || Quantity <= 1)"
                                        @onclick="DecreaseQuantity">
                                    −
                                </button>
                                <input type="number"
                                       class="form-control text-center"
                                       min="1"
                                       max="@product.Stock"
                                       @bind="Quantity"
                                       @bind:event="oninput"
                                       disabled="@(product.Stock <= 0)" />
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        aria-label="Forøg antal"
                                        disabled="@(product.Stock <= 0 || Quantity >= product.Stock)"
                                        @onclick="IncreaseQuantity">
                                    +
                                </button>
                            </div>

                        </div>

                        <!-- Læg i kurv -->
                        <button type="button"
                                class="page-button product-add-to-cart"
                                disabled="@(product.Stock <= 0)"
                                @onclick="AddToCartAsync">
                            <i class="bi bi-cart-plus"></i>
                            Læg i kurv
                        </button>

                        @if (!string.IsNullOrEmpty(CartMessage))
                        {
                            <p class="text-success mt-2" role="status">@CartMessage</p>
                        }
                        @if (!string.IsNullOrEmpty(CartError))
                        {
                            <p class="text-danger mt-2" role="alert">@CartError</p>
                        }

                    </div>

                </div>

            </div>

            <!-- PRODUKTSPECIFIKATIONER -->
            <section class="product-specifications mt-5">

                <h2>Produktspecifikationer</h2>

                <p class="page-description">
                    Her finder du alle oplysninger om produktet.
                </p>

                <div class="table-responsive mt-4">

                    <table class="table admin-table">

                        <tbody>

                            @foreach (CachedProperty propCached in
                                PropertyNameHelper.GetPropertiesWithMetaData(product.GetType()))
                            {
                                switch (propCached.Property.Name)
                                {
                                    case nameof(product.Name)
                                        or nameof(product.Description)
                                        or nameof(product.ID)
                                        or nameof(product.Price)
                                        or nameof(product.Stock):
                                        break;

                                    default:
                                        <tr>
                                            <th>
                                                @GetUserProperyName(propCached)
                                            </th>

                                            <td>
                                                @propCached.Property.GetValue(product)
                                            </td>
                                        </tr>
                                        break;
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </section>

        </div>
    }
    else
    {
        <div class="product-not-found">

            <h2>Produktet blev ikke fundet</h2>

            <p class="page-description">
                Vi kunne desværre ikke finde det ønskede produkt.
            </p>

            <a href="/" class="page-button">
                Tilbage til forsiden
            </a>

        </div>
    }

</div>

@code {

    [Parameter]
    public string Id { get; set; } = "";

    private Product? product;

    private int Quantity = 1;
    private string? CartMessage;
    private string? CartError;

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out Guid id))
        {
            product = null;
            return;
        }

        product = await ProductService.GetProductAsync(id);

        Quantity = 1;
    }

    private string GetUserProperyName(CachedProperty property)
    {
        return property.UserPageName ?? property.Property.Name;
    }

    private void GoBack()
    {
        string overviewPath = product switch
        {
            Keyboard => "/keyboards",
            Mousepad => "/mousepads",
            Keycap => "/keycaps",
            _ => "/"
        };

        Navigation.NavigateTo(overviewPath);
    }

    private async Task AddToCartAsync()
    {
        if (product is null)
        {
            return;
        }

        CartMessage = null;
        CartError = null;

        if (Quantity < 1 || Quantity > product.Stock)
        {
            CartError = $"Vælg et antal mellem 1 og {product.Stock}.";
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(
            authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out Guid userId))
        {
            string returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
            return;
        }

        await CartService.AddToCartAsync(product.ID, userId, Quantity);
        CartMessage = $"{Quantity} stk. {product.Name} blev lagt i kurven.";
    }

    private void DecreaseQuantity()
    {
        if (Quantity > 1)
        {
            Quantity--;
        }
    }

    private void IncreaseQuantity()
    {
        if (product is not null && Quantity < product.Stock)
        {
            Quantity++;
        }
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}