@page "/manage-employees/employees"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Data.Common
@attribute [Authorize(Roles = "Admin")]
@inject UserService UserService
@inject ValidationService ValidationService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ManageEmployeesList> Logger

<PageTitle>Administrer medarbejdere</PageTitle>

<div class="page-content">
    <h1>Administrer medarbejdere</h1>
    <p class="page-description">Her kan du se alle medarbejdere.</p>
    <NavLink class="page-button-outline mb-4" href="/manage-employees">← Tilbage</NavLink>

    <section class="employee-form-section">
        <h3>Alle medarbejdere</h3>

        @if (!string.IsNullOrEmpty(LoadError))
        {
            <p class="text-danger" role="alert">@LoadError</p>
        }
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fornavn</th>
                        <th>Efternavn</th>
                        <th>E-mail</th>
                        <th>Telefon</th>
                        <th>Rolle</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize TItem="User"
                                ItemsProvider="LoadEmployeesAsync"
                                Context="employee"
                                @ref="EmployeeVirtualize"
                                MaxItemCount="30"
                                SpacerElement="tr">
                        <ItemContent>
                            <tr>
                                <td>@employee.ID</td>
                                <td>@employee.FirstName</td>
                                <td>@employee.LastName</td>
                                <td>@employee.Email</td>
                                <td>@employee.PhoneNumber</td>
                                <td>@employee.Role</td>
                                <td>
                                    <button type="button" class="page-button-outline me-2"
                                            @onclick="() => BeginEdit(employee)">Rediger</button>
                                    <button type="button" class="page-button-outline"
                                            @onclick="() => BeginDelete(employee)">Fjern</button>
                                </td>
                            </tr>
                        </ItemContent>
                        <Placeholder>
                            <tr><td colspan="7">Indlæser medarbejdere...</td></tr>
                        </Placeholder>
                        <EmptyContent>
                            <tr><td colspan="7">Der er ingen medarbejdere registreret.</td></tr>
                        </EmptyContent>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (EditingUser is not null)
{
    <div class="employee-modal-overlay">
        <div class="employee-modal" role="dialog" aria-modal="true" aria-label="Rediger medarbejder">
            <h2>Rediger medarbejder</h2>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <label class="form-label">Fornavn</label>
                    <input class="form-control" @bind="EditingUser.FirstName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Efternavn</label>
                    <input class="form-control" @bind="EditingUser.LastName" />
                </div>
                <div class="col-12">
                    <label class="form-label">E-mail</label>
                    <input type="email" class="form-control" @bind="EditingUser.Email" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Adresse</label>
                    <input class="form-control" @bind="EditingUser.StreetAddress" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Lejlighed (valgfrit)</label>
                    <input class="form-control" @bind="EditingUser.Apartment" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Postnummer</label>
                    <input class="form-control" maxlength="4" @bind="EditingUser.PostalCode" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">By</label>
                    <input class="form-control" @bind="EditingUser.City" />
                </div>
                <div class="col-12">
                    <label class="form-label">Telefonnummer</label>
                    <input type="tel" class="form-control" maxlength="8" @bind="EditingUser.PhoneNumber" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ActionMessage))
            {
                <p class="text-danger mt-3" role="alert">@ActionMessage</p>
            }
            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="button" class="page-button" disabled="@IsSaving" @onclick="SaveEditAsync">
                    @(IsSaving ? "Gemmer..." : "Gem ændringer")
                </button>
                <button type="button" class="page-button-outline" disabled="@IsSaving" @onclick="CancelEdit">
                    Annuller
                </button>
            </div>
        </div>
    </div>
}

@if (DeletingUser is not null)
{
    <div class="employee-modal-overlay">
        <div class="employee-modal employee-delete-modal" role="dialog" aria-modal="true" aria-label="Bekræft fjernelse">
            <h2>Fjern medarbejder</h2>
            <p>Er du sikker på, at du vil fjerne <strong>@DeletingUser.FirstName @DeletingUser.LastName</strong>?</p>
            <p class="employee-delete-warning">Denne handling kan ikke fortrydes.</p>
            @if (!string.IsNullOrEmpty(ActionMessage))
            {
                <p class="text-danger" role="alert">@ActionMessage</p>
            }
            <div class="d-flex flex-wrap gap-3 mt-4">
                <button type="button" class="page-button-outline" disabled="@IsSaving" @onclick="CancelDelete">Annuller</button>
                <button type="button" class="employee-delete-button" disabled="@IsSaving" @onclick="ConfirmDeleteAsync">
                    @(IsSaving ? "Fjerner..." : "Fjern medarbejder")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Virtualize<User>? EmployeeVirtualize;
    private string? LoadError;
    private StaffEditModel? EditingUser;
    private User? DeletingUser;
    private bool IsSaving;
    private string? ActionMessage;

    private void BeginEdit(User employee)
    {
        ActionMessage = null;
        EditingUser = new StaffEditModel
        {
            ID = employee.ID,
            RegisterDate = employee.RegisterDate,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            Email = employee.Email,
            StreetAddress = employee.StreetAddress,
            Apartment = employee.Apartment,
            PostalCode = employee.PostalCode,
            City = employee.City,
            PhoneNumber = employee.PhoneNumber
        };
    }

    private void CancelEdit()
    {
        EditingUser = null;
        ActionMessage = null;
    }

    private async Task SaveEditAsync()
    {
        if (EditingUser is null)
        {
            return;
        }

        EditingUser.FirstName = EditingUser.FirstName.Trim();
        EditingUser.LastName = EditingUser.LastName.Trim();
        EditingUser.Email = EditingUser.Email.Trim();
        EditingUser.StreetAddress = EditingUser.StreetAddress.Trim();
        EditingUser.Apartment = EditingUser.Apartment?.Trim();
        EditingUser.PostalCode = EditingUser.PostalCode.Trim();
        EditingUser.City = EditingUser.City.Trim();
        EditingUser.PhoneNumber = EditingUser.PhoneNumber.Trim();

        if (!ValidationService.IsValidName(EditingUser.FirstName) ||
            !ValidationService.IsValidName(EditingUser.LastName) ||
            !ValidationService.IsValidEmail(EditingUser.Email) ||
            !ValidationService.IsValidAddress(EditingUser.StreetAddress) ||
            !ValidationService.IsValidPostalCode(EditingUser.PostalCode) ||
            !ValidationService.IsValidCity(EditingUser.City) ||
            !ValidationService.IsValidPhoneNumber(EditingUser.PhoneNumber))
        {
            ActionMessage = "Kontrollér oplysningerne. Alle felter undtagen lejlighed skal være gyldige.";
            return;
        }

        Guid employeeId = EditingUser.ID;
        IsSaving = true;
        try
        {
            Guid requestingUserId = await GetRequestingUserIdAsync();
            User updatedUser = new()
            {
                ID = employeeId,
                RegisterDate = EditingUser.RegisterDate,
                FirstName = EditingUser.FirstName,
                LastName = EditingUser.LastName,
                Email = EditingUser.Email,
                StreetAddress = EditingUser.StreetAddress,
                Apartment = string.IsNullOrWhiteSpace(EditingUser.Apartment) ? null : EditingUser.Apartment,
                PostalCode = EditingUser.PostalCode,
                City = EditingUser.City,
                PhoneNumber = EditingUser.PhoneNumber,
                Role = UserRole.Employee
            };
            await UserService.UpdateStaffAsync(requestingUserId, updatedUser, UserRole.Employee);
            EditingUser = null;
            await RefreshListAsync();
        }
        catch (UnauthorizedAccessException)
        {
            ActionMessage = "Kun en administrator kan redigere medarbejdere.";
        }
        catch (InvalidOperationException exception)
        {
            ActionMessage = exception.Message;
        }
        catch (NotFoundException)
        {
            ActionMessage = "Medarbejderen blev ikke fundet. Genindlæs listen.";
        }
        catch (Exception exception) when (exception is DbException or FormatException)
        {
            Logger.LogError(exception, "Could not update employee {EmployeeId}.", employeeId);
            ActionMessage = "Medarbejderen kunne ikke opdateres.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private void BeginDelete(User employee)
    {
        ActionMessage = null;
        DeletingUser = employee;
    }

    private void CancelDelete()
    {
        DeletingUser = null;
        ActionMessage = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (DeletingUser is null)
        {
            return;
        }

        Guid employeeId = DeletingUser.ID;
        IsSaving = true;
        try
        {
            Guid requestingUserId = await GetRequestingUserIdAsync();
            await UserService.DeleteStaffAsync(requestingUserId, employeeId, UserRole.Employee);
            DeletingUser = null;
            await RefreshListAsync();
        }
        catch (UnauthorizedAccessException)
        {
            ActionMessage = "Kun en administrator kan fjerne medarbejdere.";
        }
        catch (InvalidOperationException exception)
        {
            ActionMessage = exception.Message;
        }
        catch (NotFoundException)
        {
            ActionMessage = "Medarbejderen blev ikke fundet. Genindlæs listen.";
        }
        catch (DbException exception)
        {
            Logger.LogError(exception, "Could not delete employee {EmployeeId}.", employeeId);
            ActionMessage = "Medarbejderen kunne ikke fjernes. Kontoen kan være knyttet til andre data.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task<Guid> GetRequestingUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!Guid.TryParse(
                authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
                out Guid requestingUserId))
        {
            throw new UnauthorizedAccessException("An authenticated administrator is required.");
        }

        return requestingUserId;
    }

    private async Task RefreshListAsync()
    {
        ActionMessage = null;
        if (EmployeeVirtualize is not null)
        {
            await EmployeeVirtualize.RefreshDataAsync();
        }
    }

    private sealed class StaffEditModel
    {
        public Guid ID { get; set; }
        public DateOnly RegisterDate { get; set; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string StreetAddress { get; set; } = "";
        public string? Apartment { get; set; }
        public string PostalCode { get; set; } = "";
        public string City { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
    }

    private async ValueTask<ItemsProviderResult<User>> LoadEmployeesAsync(ItemsProviderRequest request)
    {
        try
        {
            (List<User> employees, int totalCount) = await UserService.GetUsersByRolePageAsync(
                UserRole.Employee,
                request.StartIndex,
                Math.Min(request.Count, 30),
                request.CancellationToken);
            LoadError = null;
            return new ItemsProviderResult<User>(employees, totalCount);
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception) when (exception is DbException or InvalidOperationException or FormatException)
        {
            Logger.LogError(exception, "Could not load a page of employees.");
            LoadError = "Medarbejderlisten kunne ikke indlæses. Prøv igen.";
            await InvokeAsync(StateHasChanged);
            return new ItemsProviderResult<User>([], 0);
        }
    }
}
