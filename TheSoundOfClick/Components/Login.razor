@page "/login"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

    <AuthCard Title="Velkommen tilbage!"
              Description="Log ind på din konto hos The Sound Of Click">

        <div class="auth-form">

            <div class="auth-field">
                <label for="email">Emailadresse</label>

                <input id="email"
                       type="email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       @bind="Email" />
            </div>

            <div class="auth-field">
                <label for="password">Adgangskode</label>

                <input id="password"
                       type="password"
                       placeholder="Indtast din adgangskode"
                       autocomplete="current-password"
                       @bind="Password" />
            </div>

            <a href="/forgot-password" class="auth-link">
                Har du glemt din adgangskode?
            </a>

            <button type="button"
                    class="auth-button"
                    @onclick="LoginUser">
                Log ind
            </button>

            @if (!string.IsNullOrEmpty(Message))
            {
                <p class="auth-message" role="status">
                    @Message
                </p>
            }

            <div class="auth-footer">
                <p>
                    Har du ikke en konto?
                    <a href="/register">Opret en konto</a>
                </p>
            </div>

        </div>

    </AuthCard>

</div>

@code {
    private string Email = "";
    private string Password = "";
    private string Message = "";

    private void LoginUser()
    {
        Message = "";

        ValidationService validationService = new ValidationService();

        if (!validationService.IsValidEmail(Email))
        {
            Message = "Du skal skrive en gyldig emailadresse.";
            return;
        }

        if (string.IsNullOrEmpty(Password))
        {
            Message = "Du skal skrive dit password.";
            return;
        }

        Message = "Loginoplysningerne er udfyldt. Login er endnu ikke implementeret.";
    }
}