@page "/login"
@rendermode InteractiveServer
@using TheSoundOfClick.Components.AuthComponents

<div class="auth-page">

    <AuthCard Title="Velkommen tilbage!"
              Description="Log ind på din konto hos The Sound Of Click">

        <form class="auth-form" method="post" action="/api/auth/signin">
            <AntiforgeryToken />
            @if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            }

            <div class="auth-field">
                <label for="email">Emailadresse</label>

                <input id="email"
                       type="email"
                       name="Email"
                       placeholder="Indtast din emailadresse"
                       autocomplete="email"
                       required />
            </div>

            <div class="auth-field">
                <label for="password">Adgangskode</label>

                <input id="password"
                       type="password"
                       name="Password"
                       placeholder="Indtast din adgangskode"
                       autocomplete="current-password"
                       required />
            </div>

            <a href="/forgot-password" class="auth-link">
                Har du glemt din adgangskode?
            </a>

            <button type="submit" class="auth-button">
                Log ind
            </button>

            @if (Error == "invalid")
            {
                <p class="auth-message" role="status">
                    Email eller adgangskode er forkert.
                </p>
            }

            <div class="auth-footer">
                <p>
                    Har du ikke en konto?
                    <a href="/register">Opret en konto</a>
                </p>
            </div>
        </form>

    </AuthCard>

</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }
}