<a href="@Link" class="category-card">

    <i class="@Icon"></i>

    <h3>@Title</h3>

    <p>@Description</p>

    <span>@LinkText</span>

</a>

@code {
    [Parameter]
    public string Icon { get; set; } = "";

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string Description { get; set; } = "";

    [Parameter]
    public string Link { get; set; } = "";

    [Parameter]
    public string LinkText { get; set; } = "";
}