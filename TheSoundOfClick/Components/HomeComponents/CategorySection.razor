@using TheSoundOfClick.Components.Shared

<section class="section-layout category-section">

    <h2 class="section-title">Shop efter kategori</h2>

    <p class="category-description">
        Find det perfekte udstyr til dit gaming setup
    </p>

    <div class="category-container">

        @foreach (var category in Categories)
        {
            <CategoryCard Icon="@category.Icon"
                          Title="@category.Title"
                          Description="@category.Description"
                          Link="@category.Link"
                          LinkText="@category.LinkText" />
        }

    </div>

</section>
@code {
    private List<CategoryItem> Categories = new()
    {
        new CategoryItem
        {
            Icon = "bi bi-keyboard",
            Title = "Tastaturer",
            Description = "Find dit næste gaming tastatur",
            Link = "/keyboards",
            LinkText = "Se tastaturer →"
        },

        new CategoryItem
        {
            Icon = "bi bi-mouse",
            Title = "Mus",
            Description = "Præcision til dit gaming setup",
            Link = "/mice",
            LinkText = "Se mus →"
        },

        new CategoryItem
        {
            Icon = "bi bi-grid",
            Title = "Musemåtter",
            Description = "Fuldfør dit gaming setup",
            Link = "/mousepads",
            LinkText = "Se musemåtter →"
        }
    };

    private class CategoryItem
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Link { get; set; } = "";
        public string LinkText { get; set; } = "";
    }
}