@using TheSoundOfClick.Components.Shared

<section class="section-layout benefits-section">

    <h2 class="section-title">Hvorfor handle hos os?</h2>

    <div class="benefits-container">

        @foreach (var benefit in Benefits)
        {
            <BenefitCard Icon="@benefit.Icon"
                         Title="@benefit.Title"
                         Description="@benefit.Description" />
        }

    </div>

</section>
@code {
    private List<BenefitItem> Benefits = new()
    {
        new BenefitItem
        {
            Icon = "bi bi-truck",
            Title = "Hurtig levering",
            Description = "Vi sørger for, at dit gamingudstyr hurtigt kommer frem."
        },

        new BenefitItem
        {
            Icon = "bi bi-shield-check",
            Title = "Sikker handel",
            Description = "Vi passer godt på dine oplysninger, når du handler hos os."
        },

        new BenefitItem
        {
            Icon = "bi bi-controller",
            Title = "Gamingudstyr",
            Description = "Find tastaturer, mus og musemåtter til dit perfekte setup."
        },

        new BenefitItem
        {
            Icon = "bi bi-chat-dots",
            Title = "Kundeservice",
            Description = "Har du spørgsmål? Vi står klar til at hjælpe dig."
        }
    };

    private class BenefitItem
    {
        public string Icon { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }
}