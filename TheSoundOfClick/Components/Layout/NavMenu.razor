    <span>🚚 2-4 dages levering</span>
    <span class="separator">✦</span>
    <span>Gratis fragt ved køb over 500 kr.</span>
    <span class="separator">✦</span>
    <span>Dansk webshop</span>
</div>

@* Navigation *@
<header class="gaming-header">

    <div class="navbar-container">

        @* Logo - klik for at gå til forsiden *@
        <a class="navbar-brand" href="/">
            <img src="/images/logo.png"
                 alt="The Sound Of Click"
                 class="navbar-logo" />
        </a>

       <nav class="navbar-links">

    <NavLink class="nav-link"
             href=""
             Match="NavLinkMatch.All">
        Home
    </NavLink>

    <NavLink class="nav-link" href="keyboards">
        Tastaturer
    </NavLink>

    <NavLink class="nav-link" href="mice">
        Mus
    </NavLink>

    <NavLink class="nav-link" href="mousepads">
        Musemåtter
    </NavLink>

    @* Kun medarbejdere og admins *@
    <AuthorizeView Roles="Employee,Admin">
        <Authorized>
            <NavLink class="nav-link" href="products">
                Administrer produkter
            </NavLink>
        </Authorized>
    </AuthorizeView>

</nav>

        @* Bruger og indkøbskurv *@
        <div class="navbar-actions">

            <NavLink class="nav-link" href="register"
                     title="Opret bruger">
                <i class="bi bi-person-plus"></i>
                <span>Opret bruger</span>
            </NavLink>

            <NavLink class="nav-link" href="login"
                     title="Log ind">
                <i class="bi bi-person-circle"></i>
                <span>Log ind</span>
            </NavLink>

            <a class="cart-button" href="cart"
               title="Indkøbskurv">
                <i class="bi bi-bag"></i>
            </a>

        </div>

    </div>

</header>