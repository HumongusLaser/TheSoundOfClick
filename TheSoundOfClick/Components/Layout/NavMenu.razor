@using Microsoft.AspNetCore.Components.Authorization

@* Øverste informationsbjælke *@
<div class="announcement-bar">
    <span>🚚 2-4 dages levering</span>
    <span class="separator">✦</span>
    <span>Gratis fragt ved køb over 500 kr.</span>
    <span class="separator">✦</span>
    <span>Dansk webshop</span>
</div>

@* Navigation *@
<header class="gaming-header">

    <div class="navbar-container">

        @* Logo - klik for at gå til forsiden *@
        <a class="navbar-brand" href="/">
            <img src="/images/logo.png"
                 alt="The Sound Of Click"
                 class="navbar-logo" />
        </a>

        <nav class="navbar-links">

            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink class="nav-link" href="keyboards">
                Tastaturer
            </NavLink>

            <NavLink class="nav-link" href="mousepads">
                Musemåtter
            </NavLink>

            <NavLink class="nav-link" href="keycaps">
                Keycaps
            </NavLink>

            @* Kun medarbejdere og admins *@
            <AuthorizeView Roles="Employee,Admin">
                <Authorized>
                    <NavLink class="nav-link" href="products">
                        Administrer produkter
                    </NavLink>
                    <NavLink class="nav-link" href="customers">
                        Oversigt over kunder
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            @* Kun medarbejdere og admins *@
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <NavLink class="nav-link" href="manage-employees">
                        Administrer medarbejdere
                    </NavLink>
                </Authorized>
            </AuthorizeView>

        </nav>

        @* Bruger og indkøbskurv *@
        <div class="navbar-actions">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="profile-button"
                             href="profile"
                             title="Min profil"
                             aria-label="Min profil">
                        <i class="bi bi-person-gear"></i>
                    </NavLink>

                    <form class="logout-form" method="post" action="/api/auth/signout">
                        <AntiforgeryToken />
                        <button class="logout-button" type="submit">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Log ud</span>
                        </button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link"
                             href="register"
                             title="Opret bruger">
                        <i class="bi bi-person-plus"></i>
                        <span>Opret bruger</span>
                    </NavLink>

                    <NavLink class="nav-link"
                             href="login"
                             title="Log ind">
                        <i class="bi bi-person-circle"></i>
                        <span>Log ind</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>

            @* Indkøbskurv *@
            <a class="cart-button"
               href="cart"
               title="Indkøbskurv">
                <i class="bi bi-bag"></i>
            </a>

        </div>

    </div>

</header>