@page "/products-menu"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@* @attribute [Authorize(Roles = "Employee,Admin")] *@

<h3>Produktadministration</h3>

<h4>Tilføj nyt produkt</h4>

<div class="mb-3">
    <label class="form-label">Vælg produktkategori</label>

    <select class="form-select" @bind="selectedCategory">
        <option value="">Vælg kategori...</option>
        <option value="keyboard">Keyboard</option>
        <option value="keycap">Keycap</option>
        <option value="mousepad">Mousepad</option>
    </select>
</div>

@if (!string.IsNullOrEmpty(selectedCategory))
{
    <h4>Produktoplysninger</h4>

    <div class="mb-3">
        <label class="form-label">Produktnavn</label>
        <input class="form-control" @bind="productName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Pris (kr.)</label>
        <input type="number" step="0.01" min="0"
               class="form-control" @bind="productPrice" />
    </div>

    <div class="mb-3">
        <label class="form-label">Lagerantal</label>
        <input type="number" min="0"
               class="form-control" @bind="productStock" />
    </div>

    <div class="mb-3">
        <label class="form-label">Farve</label>
        <input class="form-control" @bind="productColor" />
    </div>

    <div class="mb-3">
        <label class="form-label">Beskrivelse</label>
        <textarea class="form-control" @bind="productDescription"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Nettovægt (gram)</label>
        <input type="number" min="0"
               class="form-control" @bind="productNetWeight" />
    </div>
    @if (selectedCategory == "keyboard")
    {
        <h4>Oplysninger om tastaturet</h4>

        <div class="mb-3">
            <label class="form-label">Layout</label>
            <input class="form-control" @bind="keyboardLayout" />
        </div>

        <div class="mb-3">
            <label class="form-label">Switch-type</label>
            <input class="form-control" @bind="keyboardSwitchType" />
        </div>

        <div class="mb-3">
            <label class="form-label">Størrelse</label>
            <input class="form-control" @bind="keyboardSize" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                <input type="checkbox" @bind="keyboardIsWireless" />
                Trådløst tastatur
            </label>
        </div>
    }
    @if (selectedCategory == "keycap")
    {
        <h4>Oplysninger om keycaps</h4>

        <div class="mb-3">
            <label class="form-label">Tema</label>
            <input class="form-control" @bind="keycapTheme" />
        </div>

        <div class="mb-3">
            <label class="form-label">Antal keycaps i sættet</label>
            <input type="number" min="1"
                   class="form-control" @bind="keycapAmount" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                <input type="checkbox" @bind="keycapIsBacklightCompatible" />
                Kompatibel med baggrundsbelysning
            </label>
        </div>
    }
    @if (selectedCategory == "mousepad")
    {
        <h4>Oplysninger om musemåtten</h4>

        <div class="mb-3">
            <label class="form-label">Længde (mm)</label>
            <input type="number" min="1"
                   class="form-control" @bind="mousepadLength" />
        </div>

        <div class="mb-3">
            <label class="form-label">Bredde (mm)</label>
            <input type="number" min="1"
                   class="form-control" @bind="mousepadWidth" />
        </div>

        <div class="mb-3">
            <label class="form-label">Tykkelse (mm)</label>
            <input type="number" min="1"
                   class="form-control" @bind="mousepadThickness" />
        </div>
    }
    <div class="mt-4">
        <button type="button"
                class="btn btn-primary"
                @onclick="PrepareProduct">
            Gem produkt
        </button>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <p class="mt-3">@statusMessage</p>
    }

}

@code {
    private string selectedCategory = "";
    private string productName = "";
    private decimal productPrice = 0;
    private int productStock = 0;
    private string productColor = "";
    private string productDescription = "";
    private int productNetWeight = 0;
    private string keyboardLayout = "";
    private string keyboardSwitchType = "";
    private string keyboardSize = "";
    private bool keyboardIsWireless = false;
    private string keycapTheme = "";
    private int keycapAmount = 1;
    private bool keycapIsBacklightCompatible = false;
    private int mousepadLength = 1;
    private int mousepadWidth = 1;
    private int mousepadThickness = 1;
    private string statusMessage = "";

    private void PrepareProduct()
    {
        if (string.IsNullOrWhiteSpace(productName) || productName.Trim().Length < 2)
        {
            statusMessage = "Produktnavnet skal indeholde mindst 2 tegn.";
            return;
        }

        if (productPrice < 0)
        {
            statusMessage = "Prisen må ikke være negativ.";
            return;
        }

        if (productStock < 0)
        {
            statusMessage = "Lagerantallet må ikke være negativt.";
            return;
        }

        if (string.IsNullOrWhiteSpace(productColor))
        {
            statusMessage = "Du skal angive en farve.";
            return;
        }

        if (string.IsNullOrWhiteSpace(productDescription))
        {
            statusMessage = "Du skal skrive en beskrivelse.";
            return;
        }

        if (productNetWeight < 0)
        {
            statusMessage = "Nettovægten må ikke være negativ.";
            return;
        }

        if (selectedCategory == "keyboard")
        {
            if (string.IsNullOrWhiteSpace(keyboardLayout))
            {
                statusMessage = "Du skal angive tastaturets layout.";
                return;
            }

            if (string.IsNullOrWhiteSpace(keyboardSwitchType))
            {
                statusMessage = "Du skal angive switch-type.";
                return;
            }

            if (string.IsNullOrWhiteSpace(keyboardSize))
            {
                statusMessage = "Du skal angive tastaturets størrelse.";
                return;
            }
        }

        if (selectedCategory == "keycap")
        {
            if (string.IsNullOrWhiteSpace(keycapTheme))
            {
                statusMessage = "Du skal angive et tema.";
                return;
            }

            if (keycapAmount < 1)
            {
                statusMessage = "Antallet af keycaps skal være mindst 1.";
                return;
            }
        }

        if (selectedCategory == "mousepad")
        {
            if (mousepadLength < 1 || mousepadWidth < 1 || mousepadThickness < 1)
            {
                statusMessage = "Længde, bredde og tykkelse skal være større end 0.";
                return;
            }
        }
    }
}